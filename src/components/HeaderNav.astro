---
const waLink = "https://wa.me/628122729637?text=Halo%20Ibu%20Agnesia,%20saya%20dari%20website%20Grha%20Vege%20Jawi,%20ingin%20tanya%20ketersediaan%20kamar";

const allNavLinks = [
  { label: "Beranda", href: "#beranda", id: "beranda", icon: "home" },
  { label: "Fasilitas", href: "#fasilitas", id: "fasilitas", icon: "hotel_class" },
  { label: "Tentang", href: "#tentang", id: "tentang", icon: "apartment" },
  { label: "Kamar", href: "#kamar", id: "kamar", icon: "bed" },
  { label: "Galeri", href: "#galeri", id: "galeri", icon: "photo_library" },
  { label: "Testimoni", href: "#testimoni", id: "testimoni", icon: "star" },
  { label: "Lokasi", href: "#lokasi", id: "lokasi", icon: "location_on" },
  { label: "FAQ", href: "#faq", id: "faq", icon: "help_outline" },
];

const desktopNavLinks = [
  { label: "Beranda", href: "#beranda", id: "beranda" },
  { label: "Fasilitas", href: "#fasilitas", id: "fasilitas" },
  { label: "Tentang", href: "#tentang", id: "tentang" },
  { label: "Kamar", href: "#kamar", id: "kamar" },
  { label: "Galeri", href: "#galeri", id: "galeri" },
  { label: "Testimoni", href: "#testimoni", id: "testimoni" },
  { label: "Lokasi", href: "#lokasi", id: "lokasi" },
  { label: "FAQ", href: "#faq", id: "faq" },
];
---

<!-- Mobile Backdrop Dimmer -->
<div 
  id="mobile-backdrop" 
  class="fixed inset-0 bg-black/65 backdrop-blur-sm z-40 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden" 
  aria-hidden="true"
></div>

<!-- Main Navbar -->
<header id="main-header" class="fixed top-0 left-0 right-0 z-50 w-full pointer-events-none transition-[padding] duration-500 ease-spring motion-reduce:transition-none py-2.5 sm:py-4 px-3 sm:px-6 lg:px-8">
  <div 
    id="navbar-shell" 
    class="pointer-events-auto w-full max-w-7xl mx-auto flex items-center justify-between gap-2.5 sm:gap-6 px-3 sm:px-6 py-2 sm:py-2.5 transition-[max-width,padding,background-color,border-color,box-shadow,border-radius] duration-500 ease-spring motion-reduce:transition-none relative z-50"
  >
    
    <!-- Logo Brand -->
    <a 
      id="brand-logo-link"
      aria-label="Grha Vege Jawi Syariah - Kembali ke Beranda" 
      class="group flex items-center gap-2 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold transition-all duration-300 rounded-full px-2.5 py-1 sm:py-1.5 bg-white/95 backdrop-blur-md shadow-xs ring-1 ring-black/5 hover:scale-[1.03] active:scale-95" 
      href="#beranda"
    >
      <img 
        alt="Logo Emblem Grha Vege Jawi Syariah" 
        width="28"
        height="28"
        class="h-6 sm:h-7 w-6 sm:w-7 object-contain transition-transform duration-300 group-hover:rotate-[-2deg]" 
        src="/favicon.svg"
      />
      <span class="font-serif font-bold text-primary text-xs sm:text-sm tracking-tight whitespace-nowrap">
        Grha Vege Jawi
      </span>
    </a>

    <!-- Menu Desktop -->
    <nav 
      id="desktop-nav" 
      aria-label="Navigasi Utama" 
      class="hidden lg:flex items-center gap-1 xl:gap-1.5 p-1 rounded-full text-xs font-medium tracking-wide transition-all duration-300"
    >
      {desktopNavLinks.map((link, idx) => (
        <a 
          href={link.href}
          data-target-id={link.id}
          class={`nav-item px-3 py-1.5 rounded-full transition-colors duration-200 relative focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold ${
            idx === 0 
              ? 'active font-semibold text-white bg-white/20' 
              : 'text-white/85 hover:text-white hover:bg-white/10'
          }`}
        >
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <!-- Tombol Aksi Kontak & Menu Mobile -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a 
        class="group inline-flex items-center gap-1.5 sm:gap-2.5 bg-syariah-gold hover:bg-[#b58c3f] text-on-surface text-xs font-medium pl-2.5 sm:pl-3.5 pr-1.5 py-1.5 rounded-full transition-[transform,background-color,box-shadow] duration-200 shadow-md hover:shadow-lg active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold" 
        href={waLink} 
        rel="noopener noreferrer" 
        target="_blank"
        aria-label="Hubungi WhatsApp Ibu Agnesia (0812-2729-637)"
      >
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
          </span>
          <span class="font-mono text-[11px] sm:text-xs font-semibold tracking-tight text-primary-deep hidden xs:inline">
            Kontak Bu Agnesia
          </span>
          <span class="font-mono text-[11px] font-semibold tracking-tight text-primary-deep xs:hidden">
            WA
          </span>
        </div>

        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-primary flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-white shadow-xs" aria-hidden="true">
          <span class="material-symbols-outlined text-[14px] sm:text-[15px]" aria-hidden="true">chat</span>
        </div>
      </a>

      <!-- Tombol Hamburger Mobile -->
      <button 
        id="mobile-menu-btn" 
        type="button"
        aria-label="Buka Menu Navigasi" 
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="lg:hidden w-11 h-11 min-w-[44px] min-h-[44px] rounded-full transition-all duration-200 flex flex-col items-center justify-center gap-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold text-white bg-white/20 backdrop-blur-md border border-white/25 shadow-xs active:scale-95"
      >
        <span class="w-4 h-0.5 bg-current transition-transform duration-300 origin-center rounded-full pointer-events-none" id="hamb-line-1" aria-hidden="true"></span>
        <span class="w-4 h-0.5 bg-current transition-[opacity,transform] duration-300 rounded-full pointer-events-none" id="hamb-line-2" aria-hidden="true"></span>
        <span class="w-4 h-0.5 bg-current transition-transform duration-300 origin-center rounded-full pointer-events-none" id="hamb-line-3" aria-hidden="true"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-drawer" 
    role="dialog"
    aria-label="Menu Navigasi Mobile"
    class="hidden lg:hidden mt-2 max-w-lg mx-auto rounded-3xl p-2 sm:p-3 bg-white border border-stone-200/90 shadow-2xl transition-all duration-300 animate-drawer-in pointer-events-auto max-h-[calc(100dvh-4.75rem)] overflow-y-auto overscroll-contain relative z-50"
  >
    <nav class="flex flex-col divide-y divide-stone-100 text-sm font-medium text-stone-900" id="mobile-nav-items" aria-label="Daftar Menu Halaman">
      {allNavLinks.map((link) => (
        <a 
          class="mobile-nav-link min-h-[48px] px-4 py-3 rounded-2xl hover:bg-stone-50 active:bg-stone-100 transition-all duration-150 flex items-center justify-between group active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold" 
          href={link.href}
          data-target-id={link.id}
        >
          <div class="flex items-center gap-3.5">
            <span class="material-symbols-outlined text-[20px] text-primary group-hover:scale-110 transition-transform shrink-0" aria-hidden="true">{link.icon}</span>
            <span class="text-stone-900 group-hover:text-primary font-medium text-sm transition-colors">{link.label}</span>
          </div>
          <span class="material-symbols-outlined text-sm text-stone-500 group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0" aria-hidden="true">chevron_right</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const mainHeader = document.getElementById('main-header');
  const navbarShell = document.getElementById('navbar-shell');
  const brandLogoLink = document.getElementById('brand-logo-link');
  const navItems = document.querySelectorAll<HTMLAnchorElement>('.nav-item');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileBackdrop = document.getElementById('mobile-backdrop');
  const hambLine1 = document.getElementById('hamb-line-1');
  const hambLine2 = document.getElementById('hamb-line-2');
  const hambLine3 = document.getElementById('hamb-line-3');
  const heroSection = document.getElementById('beranda');

  let isScrolled = false;
  let isMenuOpen = false;

  function updateNavbarAppearance() {
    let shouldBePill = false;
    if (heroSection) {
      const heroRect = heroSection.getBoundingClientRect();
      shouldBePill = heroRect.bottom <= 80;
    } else {
      shouldBePill = window.scrollY > 400;
    }

    if (shouldBePill !== isScrolled) {
      isScrolled = shouldBePill;

      if (isScrolled) {
        mainHeader?.classList.remove('py-3', 'sm:py-4');
        mainHeader?.classList.add('py-2', 'sm:py-3');

        navbarShell?.classList.remove('w-full', 'max-w-7xl', 'px-3.5', 'sm:px-6');
        navbarShell?.classList.add(
          'w-[94%]',
          'sm:w-[90%]',
          'max-w-5xl',
          'px-3.5',
          'sm:px-5',
          'rounded-full',
          'bg-white/95',
          'backdrop-blur-2xl',
          'border',
          'border-border-stone/80',
          'shadow-ambient-lg',
          'ring-1',
          'ring-black/[0.03]'
        );

        mobileMenuBtn?.classList.remove('text-white', 'bg-white/20', 'border-white/25');
        mobileMenuBtn?.classList.add('text-primary', 'bg-surface-subtle', 'border-border-stone');

        brandLogoLink?.classList.add('shadow-xs');

        navItems.forEach(item => {
          const isActive = item.classList.contains('active');
          item.className = getNavItemClass(isActive, true);
        });

      } else {
        mainHeader?.classList.remove('py-2', 'sm:py-3');
        mainHeader?.classList.add('py-3', 'sm:py-4');

        navbarShell?.classList.remove(
          'w-[94%]',
          'sm:w-[90%]',
          'max-w-5xl',
          'px-3.5',
          'sm:px-5',
          'rounded-full',
          'bg-white/95',
          'backdrop-blur-2xl',
          'border',
          'border-border-stone/80',
          'shadow-ambient-lg',
          'ring-1',
          'ring-black/[0.03]'
        );
        navbarShell?.classList.add('w-full', 'max-w-7xl', 'px-3.5', 'sm:px-6');

        mobileMenuBtn?.classList.remove('text-primary', 'bg-surface-subtle', 'border-border-stone');
        mobileMenuBtn?.classList.add('text-white', 'bg-white/20', 'border-white/25');

        navItems.forEach(item => {
          const isActive = item.classList.contains('active');
          item.className = getNavItemClass(isActive, false);
        });
      }
    }
  }

  function getNavItemClass(isActive: boolean, inPillMode: boolean): string {
    const base = 'nav-item px-3 py-1.5 rounded-full transition-colors duration-200 relative focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold';
    if (inPillMode) {
      return isActive
        ? `${base} active font-semibold text-primary bg-primary/10`
        : `${base} text-on-surface-variant hover:text-primary hover:bg-surface-subtle/80`;
    } else {
      return isActive
        ? `${base} active font-semibold text-white bg-white/20`
        : `${base} text-white/85 hover:text-white hover:bg-white/10`;
    }
  }

  let ticking = false;
  function requestNavbarUpdate() {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        updateNavbarAppearance();
        if (window.innerWidth >= 1024 && isMenuOpen) {
          toggleMobileMenu(false);
        }
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener('scroll', requestNavbarUpdate, { passive: true });
  window.addEventListener('resize', requestNavbarUpdate, { passive: true });

  updateNavbarAppearance();

  const sectionIds = ['beranda', 'fasilitas', 'tentang', 'kamar', 'galeri', 'testimoni', 'ulasan', 'lokasi', 'faq'];
  const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

  function setActiveNavLink(activeId: string) {
    const normalizedId = activeId === 'ulasan' ? 'testimoni' : activeId;
    navItems.forEach(item => {
      const targetId = item.getAttribute('data-target-id');
      const isActive = targetId === normalizedId;
      item.className = getNavItemClass(isActive, isScrolled);
    });

    document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach(link => {
      const targetId = link.getAttribute('data-target-id');
      if (targetId === normalizedId) {
        link.classList.add('bg-primary/10', 'text-primary', 'font-bold', 'border-primary/40');
      } else {
        link.classList.remove('bg-primary/10', 'text-primary', 'font-bold', 'border-primary/40');
      }
    });
  }

  if ('IntersectionObserver' in window && sections.length > 0) {
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setActiveNavLink(entry.target.id);
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  }

  function toggleMobileMenu(open?: boolean) {
    isMenuOpen = typeof open === 'boolean' ? open : !isMenuOpen;
    mobileMenuBtn?.setAttribute('aria-expanded', isMenuOpen ? 'true' : 'false');
    mobileMenuBtn?.setAttribute('aria-label', isMenuOpen ? 'Tutup Menu Navigasi' : 'Buka Menu Navigasi');

    if (isMenuOpen) {
      mobileDrawer?.classList.remove('hidden');
      mobileBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
      mobileBackdrop?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';

      hambLine1?.classList.add('rotate-45', 'translate-y-[6px]');
      hambLine2?.classList.add('opacity-0', 'scale-50');
      hambLine3?.classList.add('-rotate-45', '-translate-y-[6px]');
    } else {
      mobileDrawer?.classList.add('hidden');
      mobileBackdrop?.classList.remove('opacity-100', 'pointer-events-auto');
      mobileBackdrop?.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';

      hambLine1?.classList.remove('rotate-45', 'translate-y-[6px]');
      hambLine2?.classList.remove('opacity-0', 'scale-50');
      hambLine3?.classList.remove('-rotate-45', '-translate-y-[6px]');
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());
  mobileBackdrop?.addEventListener('click', () => toggleMobileMenu(false));

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMobileMenu(false));
  });

  document.addEventListener('click', (e) => {
    if (isMenuOpen && mobileDrawer && mobileMenuBtn) {
      const target = e.target as Node;
      if (!mobileDrawer.contains(target) && !mobileMenuBtn.contains(target) && !mobileBackdrop?.contains(target)) {
        toggleMobileMenu(false);
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMobileMenu(false);
    }
  });
</script>
