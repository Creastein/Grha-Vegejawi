---
// src/components/RoomCatalog.astro
import { formatRupiah } from '../lib/pricing';

interface Props {
  weekdayPrice?: number;
}

const { weekdayPrice = 165000 } = Astro.props;

const waGroundLink = "https://wa.me/628122729637?text=" + encodeURIComponent("Halo Ibu Agnesia, saya ingin tanya ketersediaan dan pesan Kamar Lantai Bawah (Ground Suite) di Grha Vege Jawi");
const waUpperLink = "https://wa.me/628122729637?text=" + encodeURIComponent("Halo Ibu Agnesia, saya ingin tanya ketersediaan dan pesan Kamar Lantai Atas (Balcony Suite) di Grha Vege Jawi");
