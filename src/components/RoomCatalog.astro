---
// src/components/RoomCatalog.astro
import { formatRupiah } from '../lib/pricing';

interface Props {
  weekdayPrice?: number;
}

const { weekdayPrice = 165000 } = Astro.props;

const waGroundLink = "https://wa.me/628122729637?text=" + encodeURIComponent("Halo Ibu Agnesia, saya ingin tanya ketersediaan dan pesan Kamar Lantai Bawah (Ground Suite) di Grha Vege Jawi");
const waUpperLink = "https://wa.me/628122729637?text=" + encodeURIComponent("Halo Ibu Agnesia, saya ingin tanya ketersediaan dan pesan Kamar Lantai Atas (Balcony Suite) di Grha Vege Jawi");
---

<!-- ==================== KAMAR & STRUKTUR LANTAI (TOTAL 6 KAMAR) ==================== -->
<section class="py-24 sm:py-28 bg-surface-subtle/50 border-b border-border-stone" id="kamar">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    
    <!-- Header & Quick Badges -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 sm:mb-10">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[10px] font-mono font-medium tracking-[0.2em] uppercase bg-syariah-gold/10 text-syariah-gold border border-syariah-gold/25">
          Katalog Kamar
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-on-surface mt-2.5 tracking-tight">
          Pilihan Kamar &amp; Struktur Lantai
        </h2>
        <p class="text-on-surface-variant text-sm sm:text-base mt-2.5 leading-relaxed">
          Total 6 kamar tidur privat (2 di lantai bawah, 4 di lantai atas). Fleksibel sewa per unit atau sewa seluruh rumah untuk keluarga besar.
        </p>
      </div>

      <!-- Quick Flexibility Badges -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-primary shrink-0">
        <span class="bg-white px-3.5 py-1.5 rounded-full border border-stone-200/80 shadow-2xs font-medium">Bisa Sewa 1–6 Kamar</span>
        <span class="bg-white px-3.5 py-1.5 rounded-full border border-stone-200/80 shadow-2xs font-medium">Kapasitas 2 Orang / Kamar</span>
      </div>
    </div>

    <!-- Interactive Room Filter Switcher -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-4 border-b border-border-stone/60">
      <div class="inline-flex items-center p-1.5 rounded-full bg-white/90 backdrop-blur-md border border-stone-200/80 shadow-xs gap-1.5">
        <button data-floor="all" class="room-tab-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all bg-primary text-white shadow-xs">
          Semua Kamar (6 Unit)
        </button>
        <button data-floor="ground" class="room-tab-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all text-on-surface-variant hover:text-primary hover:bg-stone-50">
          Lantai Bawah (2 Unit)
        </button>
        <button data-floor="upper" class="room-tab-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all text-on-surface-variant hover:text-primary hover:bg-stone-50">
          Lantai Atas (4 Unit)
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-4 text-xs font-mono text-on-surface-variant">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          Queen Bed &amp; Twin Bed
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-syariah-gold"></span>
          Semua Kamar AC &amp; KM Dalam
        </span>
      </div>
    </div>

    <!-- Showcase Cards: Lantai Bawah (2 Kamar) & Lantai Atas (4 Kamar) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="room-cards-grid">
      
      <!-- Showcase 1: Lantai Bawah (Ground Floor - 2 Kamar) -->
      <article class="room-card bg-white rounded-3xl overflow-hidden shadow-[0_12px_35px_-10px_rgba(40,54,43,0.08)] border border-stone-200/80 hover:-translate-y-1.5 hover:shadow-[0_22px_45px_-10px_rgba(40,54,43,0.12)] transition-all duration-500 ease-magnetic flex flex-col group" data-card-floor="ground">
        
        <!-- Image Container -->
        <div class="relative aspect-[16/10] bg-surface-muted overflow-hidden">
          <img 
            id="ground-floor-img"
            alt="Kamar Tidur Lantai Bawah Grha Vege Jawi Syariah (Bed 160 Queen & Akses Carport)" 
            class="w-full h-full object-cover transition-all duration-700 ease-magnetic group-hover:scale-105" 
            src="/image/Kamar-lantai-bawah.webp"
            loading="lazy"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30 pointer-events-none"></div>

          <!-- Top Floating Badges -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
            <span class="bg-primary/95 backdrop-blur-md text-white text-[11px] font-mono uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-xs border border-white/10 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[15px]">bed</span>
              2 Unit • Lantai Bawah
            </span>
            <span class="bg-white/95 backdrop-blur-md text-primary text-[11px] font-mono font-medium px-3 py-1.5 rounded-full shadow-xs border border-stone-200/60 flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px] text-syariah-gold">king_bed</span>
              Queen Bed 160
            </span>
          </div>
          
          <!-- Bottom Highlight Pills -->
          <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center gap-2 text-white text-xs">
            <span class="bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-full font-mono text-[10px] border border-white/15 flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px] text-emerald-400">check_circle</span>
              Akses Datar Bebas Tangga
            </span>
            <span class="bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-full font-mono text-[10px] border border-white/15 flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px] text-amber-300">near_me</span>
              Dekat Carport &amp; Mushola
            </span>
          </div>
        </div>

        <!-- Body Details -->
        <div class="p-7 sm:p-9 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-on-surface tracking-tight">Kamar Lantai Bawah</h3>
            </div>
            <span class="text-xs font-mono text-syariah-gold uppercase tracking-wider font-semibold mt-1 block">2 Unit • Ramah Lansia &amp; Akses Datar</span>

            <p class="text-sm text-on-surface-variant mt-3 leading-relaxed">
              Dua kamar di lantai dasar dengan akses datar tanpa undakan tangga. Dilengkapi Queen Bed 160, lemari pakaian, dan meja rias. Paling dekat dengan carport, mushola, dan dapur mini — ideal untuk orang tua atau keluarga dengan koper besar.
            </p>

            <!-- Keunggulan Utama Khusus Lantai Bawah -->
            <div class="mt-6 pt-5 border-t border-stone-100">
              <h4 class="text-[11px] font-mono uppercase tracking-widest text-primary font-semibold mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[15px] text-primary">verified</span>
                Keunggulan Spesifik
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">elderly</span>
                    <span class="text-xs font-semibold text-on-surface">Bebas Tangga</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Akses datar tanpa undakan, ramah lansia, balita, dan koper besar.</span>
                </div>
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">mosque</span>
                    <span class="text-xs font-semibold text-on-surface">Dekat Ibadah</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Langkah singkat ke ruang sholat representatif &amp; tempat wudhu.</span>
                </div>
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">directions_car</span>
                    <span class="text-xs font-semibold text-on-surface">Akses Carport</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Praktis untuk bongkar-muat barang dari kendaraan di parkiran.</span>
                </div>
              </div>

              <!-- Standar Fasilitas Ringkas (Bebas Redundansi) -->
              <div class="mt-4 px-3.5 py-2.5 rounded-2xl bg-surface-subtle/70 border border-stone-200/60 flex items-center gap-2 text-xs font-mono text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-primary shrink-0">check_circle</span>
                <span>Standar tiap unit: AC sejuk, KM Dalam (Water Heater), TV, WiFi fiber &amp; amenities.</span>
              </div>
            </div>
          </div>

          <!-- Pricing & Button-in-Button CTA -->
          <div class="mt-8 pt-6 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-on-surface-variant block">Tarif Menginap Weekday</span>
              <div class="font-serif text-2xl sm:text-3xl font-medium text-primary mt-0.5">
                {formatRupiah(weekdayPrice)} <span class="text-xs font-sans font-normal text-on-surface-variant">/ malam (2 orang)</span>
              </div>
            </div>
            
            <a 
              class="group/btn inline-flex items-center justify-between gap-3 text-xs font-mono font-medium text-white bg-primary hover:bg-primary-hover pl-5 pr-2 py-2.5 rounded-full shadow-xs hover:shadow-md transition-all duration-300 active:scale-[0.98] shrink-0" 
              href={waGroundLink} 
              rel="noopener noreferrer" 
              target="_blank"
            >
              <span>Pesan Kamar Bawah</span>
              <div class="w-7 h-7 rounded-full bg-white/20 group-hover/btn:bg-white text-white group-hover/btn:text-primary flex items-center justify-center transition-all duration-300">
                <span class="material-symbols-outlined text-[15px] group-hover/btn:translate-x-0.5 transition-transform">arrow_forward</span>
              </div>
            </a>
          </div>

        </div>
      </article>

      <!-- Showcase 2: Lantai Atas (Upper Floor - 4 Kamar) -->
      <article class="room-card bg-white rounded-3xl overflow-hidden shadow-[0_12px_35px_-10px_rgba(40,54,43,0.08)] border border-stone-200/80 hover:-translate-y-1.5 hover:shadow-[0_22px_45px_-10px_rgba(40,54,43,0.12)] transition-all duration-500 ease-magnetic flex flex-col group" data-card-floor="upper">
        
        <!-- Image Container -->
        <div class="relative aspect-[16/10] bg-surface-muted overflow-hidden">
          <img 
            id="upper-floor-img"
            alt="Kamar Tidur Lantai Atas Grha Vege Jawi Syariah (Bed 160 Queen Kisi Kayu)" 
            class="w-full h-full object-cover transition-all duration-700 ease-magnetic group-hover:scale-105" 
            src="/image/kamar-lantai-atas-160.webp"
            loading="lazy"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30 pointer-events-none"></div>

          <!-- Top Floating Badges -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
            <span class="bg-primary/95 backdrop-blur-md text-white text-[11px] font-mono uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-xs border border-white/10 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[15px]">apartment</span>
              4 Unit • Lantai Atas
            </span>
            <span class="bg-white/95 backdrop-blur-md text-primary text-[11px] font-mono font-medium px-3 py-1.5 rounded-full shadow-xs border border-stone-200/60 flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px] text-syariah-gold">bed</span>
              Pilihan Bed 160 / 140
            </span>
          </div>
          
          <!-- Bottom Highlight Pills & Photo Toggle -->
          <div class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-2 text-white text-xs">
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="bg-black/60 backdrop-blur-xs px-2.5 py-0.5 rounded-full font-mono text-[10px] border border-white/15 flex items-center gap-1">
                <span class="material-symbols-outlined text-[12px] text-emerald-400">deck</span>
                Balkon &amp; Sofa Jati
              </span>
            </div>

            <!-- Interactive Photo Toggle -->
            <div class="flex items-center gap-1">
              <button 
                type="button" 
                data-img="/image/kamar-lantai-atas-160.webp" 
                data-alt="Kamar Lt. Atas - Bed 160 Queen Kisi Kayu Grha Vege Jawi"
                class="upper-photo-toggle active px-2 py-0.5 rounded-full text-[10px] font-mono font-medium backdrop-blur-md transition-all bg-syariah-gold text-white shadow-xs border border-white/30 cursor-pointer"
                title="Lihat Bed 160 Queen (Kisi Kayu)"
              >
                Bed 160
              </button>
              <button 
                type="button" 
                data-img="/image/Kamar-lantai-atas-140.webp" 
                data-alt="Kamar Lt. Atas - Bed 140 Meja Kerja Grha Vege Jawi"
                class="upper-photo-toggle px-2 py-0.5 rounded-full text-[10px] font-mono font-medium backdrop-blur-md transition-all bg-black/60 text-white/80 hover:bg-black/80 hover:text-white border border-white/20 cursor-pointer"
                title="Lihat Bed 140 (Meja Kerja)"
              >
                Bed 140
              </button>
              <button 
                type="button" 
                data-img="/image/balkon-lantai-atas.webp" 
                data-alt="Balkon dan Sofa Jati Lantai Atas Grha Vege Jawi"
                class="upper-photo-toggle px-2 py-0.5 rounded-full text-[10px] font-mono font-medium backdrop-blur-md transition-all bg-black/60 text-white/80 hover:bg-black/80 hover:text-white border border-white/20 cursor-pointer"
                title="Lihat Balkon & Sofa Jati"
              >
                Balkon
              </button>
            </div>
          </div>
        </div>

        <!-- Body Details -->
        <div class="p-7 sm:p-9 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-on-surface tracking-tight">Kamar Lantai Atas</h3>
            </div>
            <span class="text-xs font-mono text-syariah-gold uppercase tracking-wider font-semibold mt-1 block">4 Unit • Hening &amp; Sirkulasi Asri</span>

            <p class="text-sm text-on-surface-variant mt-3 leading-relaxed">
              Empat kamar di lantai dua dengan suasana lebih privat dan angin semilir sejuk. Tersedia opsi Bed 160 (kisi kayu) dan Bed 140 (meja kerja untuk WFC/kuliah). Koridor santai dilengkapi sofa jati.
            </p>

            <!-- Keunggulan Utama Khusus Lantai Atas -->
            <div class="mt-6 pt-5 border-t border-stone-100">
              <h4 class="text-[11px] font-mono uppercase tracking-widest text-primary font-semibold mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[15px] text-primary">verified</span>
                Keunggulan Spesifik
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">deck</span>
                    <span class="text-xs font-semibold text-on-surface">Area Balkon</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Balkon terbuka dengan sofa jati untuk bersantai atau ngopi pagi.</span>
                </div>
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">laptop_mac</span>
                    <span class="text-xs font-semibold text-on-surface">Meja Kerja (WFC)</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Opsi Bed 140 dengan meja &amp; stopkontak nyaman untuk laptop.</span>
                </div>
                <div class="p-3 rounded-2xl bg-surface-subtle/80 border border-stone-200/70 flex flex-col justify-between">
                  <div class="flex items-center gap-1.5 text-primary mb-1">
                    <span class="material-symbols-outlined text-[18px]">groups</span>
                    <span class="text-xs font-semibold text-on-surface">Keluarga Besar</span>
                  </div>
                  <span class="text-[11px] text-on-surface-variant leading-tight">Bisa disewa satuan atau diborong seluruh 4 kamar sekaligus.</span>
                </div>
              </div>

              <!-- Standar Fasilitas Ringkas (Bebas Redundansi) -->
              <div class="mt-4 px-3.5 py-2.5 rounded-2xl bg-surface-subtle/70 border border-stone-200/60 flex items-center gap-2 text-xs font-mono text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-primary shrink-0">check_circle</span>
                <span>Standar tiap unit: AC sejuk, KM Dalam (Water Heater), TV, WiFi fiber &amp; amenities.</span>
              </div>
            </div>
          </div>

          <!-- Pricing & Button-in-Button CTA -->
          <div class="mt-8 pt-6 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-on-surface-variant block">Tarif Menginap Weekday</span>
              <div class="font-serif text-2xl sm:text-3xl font-medium text-primary mt-0.5">
                {formatRupiah(weekdayPrice)} <span class="text-xs font-sans font-normal text-on-surface-variant">/ malam (2 orang)</span>
              </div>
            </div>
            
            <a 
              class="group/btn inline-flex items-center justify-between gap-3 text-xs font-mono font-medium text-white bg-primary hover:bg-primary-hover pl-5 pr-2 py-2.5 rounded-full shadow-xs hover:shadow-md transition-all duration-300 active:scale-[0.98] shrink-0" 
              href={waUpperLink} 
              rel="noopener noreferrer" 
              target="_blank"
            >
              <span>Pesan Kamar Atas</span>
              <div class="w-7 h-7 rounded-full bg-white/20 group-hover/btn:bg-white text-white group-hover/btn:text-primary flex items-center justify-center transition-all duration-300">
                <span class="material-symbols-outlined text-[15px] group-hover/btn:translate-x-0.5 transition-transform">arrow_forward</span>
              </div>
            </a>
          </div>

        </div>
      </article>

    </div>

  </div>
</section>

<script>
  // Interactive Room Floor Switcher
  const roomTabBtns = document.querySelectorAll<HTMLButtonElement>('.room-tab-btn');
  const roomCards = document.querySelectorAll<HTMLElement>('.room-card');

  roomTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const floor = btn.getAttribute('data-floor');

      // Update Tab Styles
      roomTabBtns.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'shadow-xs');
        b.classList.add('text-on-surface-variant', 'hover:text-primary', 'hover:bg-stone-50');
      });
      btn.classList.add('bg-primary', 'text-white', 'shadow-xs');
      btn.classList.remove('text-on-surface-variant', 'hover:text-primary', 'hover:bg-stone-50');

      // Filter Cards with clean opacity fade
      roomCards.forEach(card => {
        const cardFloor = card.getAttribute('data-card-floor');
        if (floor === 'all' || floor === cardFloor) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });
    });
  });

  // Upper Floor Photo Toggle (Bed 160 vs Bed 140 vs Balkon)
  const upperPhotoToggles = document.querySelectorAll<HTMLButtonElement>('.upper-photo-toggle');
  const upperImg = document.getElementById('upper-floor-img') as HTMLImageElement | null;

  upperPhotoToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const newImg = toggle.getAttribute('data-img');
      const newAlt = toggle.getAttribute('data-alt');
      if (upperImg && newImg) {
        upperImg.src = newImg;
        if (newAlt) upperImg.alt = newAlt;

        upperPhotoToggles.forEach(t => {
          t.classList.remove('active', 'bg-syariah-gold', 'text-white', 'border-white/30');
          t.classList.add('bg-black/60', 'text-white/80', 'border-white/20');
        });
        toggle.classList.add('active', 'bg-syariah-gold', 'text-white', 'border-white/30');
        toggle.classList.remove('bg-black/60', 'text-white/80', 'border-white/20');
      }
    });
  });
</script>
