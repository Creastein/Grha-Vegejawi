<!-- ==================== KAMAR & STRUKTUR LANTAI (TOTAL 6 KAMAR) ==================== -->
<section class="py-24 sm:py-28 bg-surface-subtle/50 border-b border-border-stone" id="kamar">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    
    <!-- Header -->
    <!-- Header -->
