            </span>
          </div>
        </div>

        <!-- Body Details -->
        <div class="p-7 sm:p-9 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-on-surface tracking-tight">Kamar Lantai Atas (4 Unit)</h3>
            </div>
            <span class="text-xs font-mono text-syariah-gold uppercase tracking-wider font-semibold mt-1 block">Tersedia 4 Unit • Balkon &amp; Sirkulasi Asri</span>

