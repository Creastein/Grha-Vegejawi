---
// src/components/LocationTransit.astro
const gmapsUrl = "https://www.google.com/maps/place/Grha+Vege+Jawi+Syariah/@-7.7919649,110.4029812,747m/data=!3m2!1e3!4b1!4m9!3m8!1s0x2e7a59f05b3c9853:0xec78eefc19d7a5a8!5m2!4m1!1i2!8m2!3d-7.7919649!4d110.4029812!16s%2Fg%2F11f773xm6s";
---

<!-- ==================== LOKASI & AKSES SEKITAR (BENTO GRID 2.0 & RADAR) ==================== -->
<section class="py-24 sm:py-32 bg-surface-subtle/50 border-b border-border-stone scroll-mt-20 overflow-hidden" id="lokasi">
  <div class="max-w-7xl mx-auto px-4 xs:px-6 lg:px-10">
    
    <!-- Section Header: Editorial Eyebrow & High-Contrast Typography -->
    <div class="max-w-3xl mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-syariah-gold/10 border border-syariah-gold/30 text-[11px] font-mono uppercase tracking-widest text-primary font-semibold mb-3.5">
        <span class="w-1.5 h-1.5 rounded-full bg-syariah-gold animate-pulse" aria-hidden="true"></span>
        <span>Google Maps Verified Coordinates • Banguntapan, Bantul</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-on-surface tracking-tight leading-[1.15]">
        Ketenangan Hunian Syariah di Tengah Sentra Kuliner &amp; Dinamika Kampus
      </h2>
      <p class="text-xs sm:text-sm text-on-surface-variant mt-3.5 leading-relaxed text-justify sm:text-left">
        Terletak di lingkungan Banguntapan yang damai dan asri. Berkat lokasinya yang strategis di kawasan kampus Yogyakarta, aneka ragam kuliner dari warung murah mahasiswa hingga resto &amp; cafe kekinian, minimarket, apotek, dan perbankan dapat dijangkau hanya dalam hitungan langkah kaki.
      </p>
    </div>

    <!-- ==================== 1. HERO MAP BENTO CARD (DI ATAS) ==================== -->
    <div class="mb-14 sm:mb-20">
      <div class="bg-white rounded-[2rem] p-3 sm:p-3.5 border border-stone-200/70 shadow-[0_8px_30px_-10px_rgba(40,54,43,0.05)]">
        
        <!-- Map Container with High-Res Satellite View -->
        <div 
          class="relative min-h-[400px] sm:min-h-[480px] lg:min-h-[520px] rounded-[calc(2rem-0.75rem)] overflow-hidden bg-cover bg-center border border-stone-200/50 flex flex-col justify-between p-4 sm:p-6 group/map"
          style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD3TrA-ImBhQQCNqjZAd-H17IEe3zrD5VwvptQW2KUtcvHik7WSWf-Wl7tM5u1CnU3WHVwrcv4nmtEzlSjkc3GpIPYvc1aMOL05dSg63hQ3gd5uXHDh5jQzu--kvfEAJgGIUU1uo_8IjY93i3kMYmljWagrVuxFxG9jFEYmRFqXPuA4tZU-xOc01iqedLEyEiw-1PeknD5leHrXGRZB-8A4guG0Wn76fLdn4cvUZTsvgOhJbPWMLtq9dQ');"
        >
          <!-- Ambient Contrast Vignette -->
          <div class="absolute inset-0 bg-gradient-to-b from-stone-900/40 via-transparent to-stone-900/60 pointer-events-none"></div>

          <!-- Top Floating Badges (Liquid Glass Refraction) -->
          <div class="flex flex-wrap items-center justify-between gap-2.5 z-10">
            
            <!-- Rating Pill Link to Google Maps -->
            <a 
              href={gmapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full text-primary font-mono text-[11px] shadow-sm font-medium border border-stone-200/60 hover:border-primary/40 flex items-center gap-1.5 transition-all group/rate"
              title="Lihat 308 Ulasan di Google Maps"
            >
              <span class="text-amber-500 font-bold" aria-hidden="true">★ 4,6</span>
              <span class="text-on-surface-variant font-sans">• 308 Ulasan</span>
              <span class="material-symbols-outlined text-[13px] text-primary group-hover/rate:translate-x-0.5 transition-transform">open_in_new</span>
            </a>

            <!-- Live GPS Coordinates with Copy Micro-Interaction -->
            <button 
              id="copy-gps-btn" 
              type="button" 
              data-gps="-7.7919649, 110.4029812"
              class="bg-white/95 backdrop-blur-md hover:bg-white text-on-surface hover:text-primary px-3.5 py-1.5 rounded-full font-mono text-[11px] shadow-sm border border-stone-200/60 transition-all flex items-center gap-1.5 active:scale-95 cursor-pointer group/gps"
              title="Klik untuk salin koordinat GPS"
            >
              <span class="material-symbols-outlined text-[15px] text-primary group-hover/gps:rotate-45 transition-transform" id="gps-icon">my_location</span>
              <span id="gps-text">-7.7919649, 110.4029812</span>
            </button>

          </div>

          <!-- Precision Pulsing Radar Center Pin (Live Core Marker) -->
          <div class="absolute top-[40%] left-[50%] -translate-x-1/2 -translate-y-1/2 z-10 flex flex-col items-center pointer-events-none">
            <span class="w-20 h-20 rounded-full bg-emerald-500/25 animate-ping absolute -top-5 -left-5"></span>
            <span class="w-12 h-12 rounded-full bg-emerald-500/30 animate-pulse absolute -top-1 -left-1"></span>
            <div class="w-10 h-10 rounded-full bg-primary border-2 border-white text-white flex items-center justify-center shadow-xl backdrop-blur-xs relative z-10 ring-4 ring-emerald-500/30">
              <span class="material-symbols-outlined text-[20px]">hotel</span>
            </div>
            <div class="mt-2.5 bg-white/95 backdrop-blur-md px-3.5 py-1 rounded-full border border-stone-200/90 shadow-lg text-center whitespace-nowrap">
              <span class="text-[11px] font-semibold text-primary font-serif block">Grha Vege Jawi Syariah</span>
              <span class="text-[9px] font-mono text-emerald-700 font-semibold tracking-wide">Pusat Hunian Tenang</span>
            </div>
          </div>

          <!-- Bottom Hardware Dock (Double-Bezel & Button-in-Button CTA) -->
          <div class="bg-white/95 backdrop-blur-md p-4 sm:p-5 rounded-2xl shadow-xl border border-stone-200/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 z-10">
            <div class="flex items-start gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 border border-primary/20 mt-0.5">
                <span class="material-symbols-outlined text-[22px]">location_on</span>
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="text-xs sm:text-sm font-semibold text-on-surface truncate">Grha Vege Jawi Syariah</h3>
                  <span class="text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/80">Syariah</span>
                </div>
                <p class="text-[11px] sm:text-xs text-on-surface-variant font-mono mt-0.5 break-words leading-tight">Jl. Turonggo No.125, Banguntapan, Bantul 55189</p>
                
                <!-- Interactive Action: Salin Alamat Lengkap -->
                <button 
                  id="copy-address-btn" 
                  type="button" 
                  data-address="Jl. Turonggo No.125, Banguntapan, Bantul, Daerah Istimewa Yogyakarta 55189"
                  class="mt-1.5 inline-flex items-center gap-1.5 text-[11px] font-mono text-primary hover:text-primary-deep font-semibold underline underline-offset-2 decoration-primary/40 hover:decoration-primary cursor-pointer active:scale-95 transition-all"
                >
                  <span class="material-symbols-outlined text-[14px]" id="copy-icon">content_copy</span>
                  <span id="copy-text">Salin Alamat Lengkap</span>
                </button>
              </div>
            </div>

            <!-- Primary CTA: Button-in-Button Trailing Icon -->
            <a 
              href={gmapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/btn w-full sm:w-auto px-5 py-3 rounded-full bg-primary hover:bg-primary-deep text-white text-xs font-semibold tracking-wide transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-between sm:justify-center gap-3 active:scale-[0.98] shrink-0"
            >
              <span>Buka di Google Maps</span>
              <div class="w-7 h-7 rounded-full bg-white/20 group-hover/btn:bg-white/30 flex items-center justify-center transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 shrink-0">
                <span class="material-symbols-outlined text-[15px]">open_in_new</span>
              </div>
            </a>
          </div>

        </div>

      </div>

      <!-- Microcopy Guidance Notice -->
      <div class="mt-3.5 px-3 flex items-center gap-2 text-[11px] font-mono text-on-surface-variant">
        <span class="material-symbols-outlined text-[16px] text-primary shrink-0">info</span>
        <span>Koordinat presisi &amp; panduan arah gang masuk dikirimkan melalui WhatsApp sesaat setelah reservasi diterima.</span>
      </div>
    </div>

    <!-- ==================== 2. KATEGORI & CURATED AKSES SEKITAR (DI BAWAH) ==================== -->
    <div>
      
      <!-- Exploration Subheader & Category Filter Dock -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-5 sm:mb-6">
        <div>
          <span class="text-[11px] font-mono font-semibold uppercase tracking-widest text-primary/80 block mb-0.5">Eksplorasi Area</span>
          <h3 class="font-serif text-xl sm:text-2xl font-semibold text-on-surface tracking-tight">
            Destinasi Sekitar Hunian
          </h3>
          <p class="text-xs text-on-surface-variant mt-0.5">
            Kuliner, kebutuhan harian, dan kampus dalam jangkauan singkat.
          </p>
        </div>

        <!-- Category Filter Tabs: Luxury Segmented Control Dock -->
        <div class="w-full sm:w-auto overflow-x-auto no-scrollbar py-0.5 shrink-0">
          <div 
            class="inline-flex items-center gap-1 p-1 rounded-full bg-stone-100/90 border border-stone-200/80 backdrop-blur-sm shadow-xs" 
            id="poi-filter-tabs"
            role="tablist"
            aria-label="Filter Kategori Akses Sekitar"
          >
            <button 
              type="button" 
              role="tab"
              aria-selected="true"
              data-filter="all" 
              class="poi-tab active px-3.5 py-1.5 rounded-full text-xs font-sans font-semibold tracking-wide transition-all duration-200 bg-primary text-white shadow-xs cursor-pointer select-none whitespace-nowrap active:scale-95"
            >
              Semua Akses
            </button>
            <button 
              type="button" 
              role="tab"
              aria-selected="false"
              data-filter="kuliner" 
              class="poi-tab px-3.5 py-1.5 rounded-full text-xs font-sans font-medium tracking-wide transition-all duration-200 text-stone-600 hover:text-primary hover:bg-white/80 cursor-pointer select-none whitespace-nowrap active:scale-95"
            >
              Kuliner &amp; Cafe
            </button>
            <button 
              type="button" 
              role="tab"
              aria-selected="false"
              data-filter="kebutuhan" 
              class="poi-tab px-3.5 py-1.5 rounded-full text-xs font-sans font-medium tracking-wide transition-all duration-200 text-stone-600 hover:text-primary hover:bg-white/80 cursor-pointer select-none whitespace-nowrap active:scale-95"
            >
              Kebutuhan &amp; ATM
            </button>
            <button 
              type="button" 
              role="tab"
              aria-selected="false"
              data-filter="wisata" 
              class="poi-tab px-3.5 py-1.5 rounded-full text-xs font-sans font-medium tracking-wide transition-all duration-200 text-stone-600 hover:text-primary hover:bg-white/80 cursor-pointer select-none whitespace-nowrap active:scale-95"
            >
              Kampus &amp; Wisata
            </button>
          </div>
        </div>
      </div>

      <!-- POI Cards Grid: 3 Columns on Tablet/Desktop, 1 Column on Mobile -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch transition-all duration-300" id="poi-cards-grid">
        
        <!-- POI Card 1: Kuliner Kampus & Cafe (Category: kuliner) -->
        <article class="poi-card bg-white rounded-2xl p-4 sm:p-5 border border-stone-200/70 shadow-[0_4px_16px_-4px_rgba(40,54,43,0.03)] hover:shadow-md hover:border-syariah-gold/50 transition-all duration-300 flex flex-col justify-between group/poi h-full" data-category="kuliner">
          <div>
            <div class="flex items-start justify-between gap-2.5 mb-2">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-900 border border-amber-500/20 flex items-center justify-center shrink-0 group-hover/poi:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[19px]">restaurant</span>
                </div>
                <div>
                  <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-amber-800 block">Sentra Kuliner</span>
                  <h4 class="font-serif text-sm sm:text-base font-semibold text-on-surface">Kuliner &amp; Cafe Sekitar</h4>
                </div>
              </div>
              <span class="font-mono text-[10px] text-primary font-semibold bg-primary/10 border border-primary/15 px-2 py-0.5 rounded-full shrink-0">± 1-3 Mnt</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-normal mt-1.5">
              Pilihan warung makan mahasiswa hemat hingga resto &amp; cafe keluarga santai.
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-3.5 pt-3 border-t border-stone-100">
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Warung Murah</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Resto Keluarga</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Cafe Santai</span>
            <span class="text-[10px] font-mono text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-2.5 py-0.5 rounded-full font-medium">Halal &amp; Non-Halal</span>
          </div>
        </article>

        <!-- POI Card 2: Kebutuhan Harian, Perbankan & Kesehatan (Category: kebutuhan) -->
        <article class="poi-card bg-white rounded-2xl p-4 sm:p-5 border border-stone-200/70 shadow-[0_4px_16px_-4px_rgba(40,54,43,0.03)] hover:shadow-md hover:border-syariah-gold/50 transition-all duration-300 flex flex-col justify-between group/poi h-full" data-category="kebutuhan">
          <div>
            <div class="flex items-start justify-between gap-2.5 mb-2">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-sky-500/10 text-sky-900 border border-sky-500/20 flex items-center justify-center shrink-0 group-hover/poi:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[19px]">local_pharmacy</span>
                </div>
                <div>
                  <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-sky-800 block">Kebutuhan Harian</span>
                  <h4 class="font-serif text-sm sm:text-base font-semibold text-on-surface">Kebutuhan Harian &amp; ATM</h4>
                </div>
              </div>
              <span class="font-mono text-[10px] text-primary font-semibold bg-primary/10 border border-primary/15 px-2 py-0.5 rounded-full shrink-0">± 2 Mnt</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-normal mt-1.5">
              Belanja harian, apotek 24 jam, klinik kesehatan, daycare, dan ATM perbankan.
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-3.5 pt-3 border-t border-stone-100">
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Indomaret</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Apotek &amp; Klinik</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Daycare</span>
            <span class="text-[10px] font-mono text-primary bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full font-medium">ATM Mandiri • BRI • BCA</span>
          </div>
        </article>

        <!-- POI Card 3: Olahraga, Budaya & Hub Kampus/Wisata (Category: wisata) -->
        <article class="poi-card bg-white rounded-2xl p-4 sm:p-5 border border-stone-200/70 shadow-[0_4px_16px_-4px_rgba(40,54,43,0.03)] hover:shadow-md hover:border-syariah-gold/50 transition-all duration-300 flex flex-col justify-between group/poi h-full" data-category="wisata">
          <div>
            <div class="flex items-start justify-between gap-2.5 mb-2">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-900 border border-emerald-500/20 flex items-center justify-center shrink-0 group-hover/poi:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[19px]">directions_run</span>
                </div>
                <div>
                  <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-emerald-800 block">Olahraga &amp; Wisata</span>
                  <h4 class="font-serif text-sm sm:text-base font-semibold text-on-surface">Kampus, Wisata &amp; Olahraga</h4>
                </div>
              </div>
              <span class="font-mono text-[10px] text-primary font-semibold bg-primary/10 border border-primary/15 px-2 py-0.5 rounded-full shrink-0">± 3-8 Mnt</span>
            </div>
            <p class="text-xs text-on-surface-variant leading-normal mt-1.5">
              Jalur jalan pagi asri, akses kampus terdekat, rekreasi keluarga, dan venue JEC.
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-3.5 pt-3 border-t border-stone-100">
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Jogging Track</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Pura Banguntapan</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">Kampus UIN / UAJY</span>
            <span class="text-[10px] font-mono text-stone-600 bg-stone-100/90 border border-stone-200/40 px-2.5 py-0.5 rounded-full">JEC &amp; Gembira Loka</span>
          </div>
        </article>

      </div>
    </div>

  </div>
</section>

<!-- Client-side Interactive Script for Tabs Filtering & Tactile Clipboard Copy -->
<script>
  // 1. POI Category Filter Tabs (Segmented Dock Controller)
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.poi-tab');
  const poiCards = document.querySelectorAll<HTMLElement>('.poi-card');
  const poiCardsGrid = document.getElementById('poi-cards-grid');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active segmented dock tab styles
      tabButtons.forEach(t => {
        t.classList.remove('active', 'bg-primary', 'text-white', 'shadow-xs');
        t.classList.add('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.remove('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');
      btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-xs');
      btn.setAttribute('aria-selected', 'true');

      // Adjust grid layout dynamically: 3 cols when 'all', centered single column when filtered
      if (poiCardsGrid) {
        if (filter === 'all') {
          poiCardsGrid.className = 'grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch transition-all duration-300';
        } else {
          poiCardsGrid.className = 'grid grid-cols-1 max-w-lg mx-auto gap-5 items-stretch transition-all duration-300';
        }
      }

      // Filter POI Cards with smooth fade & visibility
      poiCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.style.display = 'flex';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // 2. Tactile Copy Address Action
  const copyAddressBtn = document.getElementById('copy-address-btn');
  const copyIcon = document.getElementById('copy-icon');
  const copyText = document.getElementById('copy-text');

  copyAddressBtn?.addEventListener('click', async () => {
    const address = copyAddressBtn.getAttribute('data-address') || '';
    if (address && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(address);
        if (copyIcon && copyText) {
          copyIcon.textContent = 'check_circle';
          copyIcon.classList.add('text-emerald-600');
          copyText.textContent = 'Alamat Berhasil Disalin!';
          copyText.classList.add('text-emerald-700');

          setTimeout(() => {
            copyIcon.textContent = 'content_copy';
            copyIcon.classList.remove('text-emerald-600');
            copyText.textContent = 'Salin Alamat Lengkap';
            copyText.classList.remove('text-emerald-700');
          }, 2500);
        }
      } catch (e) {
        console.error('Clipboard copy error:', e);
      }
    }
  });

  // 3. Tactile Copy GPS Coordinates Action
  const copyGpsBtn = document.getElementById('copy-gps-btn');
  const gpsIcon = document.getElementById('gps-icon');
  const gpsText = document.getElementById('gps-text');

  copyGpsBtn?.addEventListener('click', async () => {
    const gps = copyGpsBtn.getAttribute('data-gps') || '';
    if (gps && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(gps);
        if (gpsIcon && gpsText) {
          gpsIcon.textContent = 'check_circle';
          gpsIcon.classList.add('text-emerald-600');
          const originalText = gpsText.textContent;
          gpsText.textContent = 'GPS Disalin!';

          setTimeout(() => {
            gpsIcon.textContent = 'my_location';
            gpsIcon.classList.remove('text-emerald-600');
            gpsText.textContent = originalText;
          }, 2500);
        }
      } catch (e) {
        console.error('GPS copy error:', e);
      }
    }
  });
</script>

