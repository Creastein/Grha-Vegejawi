<!-- Client-side Interactive Script for Tabs Filtering & Tactile Clipboard Copy -->
<script>
  // 1. POI Category Filter Tabs (Segmented Dock Controller)
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.poi-tab');
  const poiCards = document.querySelectorAll<HTMLElement>('.poi-card');
  const poiCardsGrid = document.getElementById('poi-cards-grid');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active segmented dock tab styles
      tabButtons.forEach(t => {
        t.classList.remove('active', 'bg-primary', 'text-white', 'shadow-xs');
        t.classList.add('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.remove('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');
      btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-xs');
      btn.setAttribute('aria-selected', 'true');

      // Adjust grid layout dynamically: 3 cols when 'all', centered single column when filtered
      if (poiCardsGrid) {
        if (filter === 'all') {
          poiCardsGrid.className = 'grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch transition-all duration-300';
        } else {
          poiCardsGrid.className = 'grid grid-cols-1 max-w-lg mx-auto gap-5 items-stretch transition-all duration-300';
        }
      }

      // Filter POI Cards with smooth fade & visibility
      poiCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.style.display = 'flex';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // 2. Tactile Copy Address Action
  const copyAddressBtn = document.getElementById('copy-address-btn');
  const copyIcon = document.getElementById('copy-icon');
  const copyText = document.getElementById('copy-text');

  copyAddressBtn?.addEventListener('click', async () => {
    const address = copyAddressBtn.getAttribute('data-address') || '';
    if (address && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(address);
        if (copyIcon && copyText) {
          copyIcon.textContent = 'check_circle';
          copyIcon.classList.add('text-emerald-600');
          copyText.textContent = 'Alamat Berhasil Disalin!';
          copyText.classList.add('text-emerald-700');

          setTimeout(() => {
            copyIcon.textContent = 'content_copy';
            copyIcon.classList.remove('text-emerald-600');
            copyText.textContent = 'Salin Alamat Lengkap';
            copyText.classList.remove('text-emerald-700');
          }, 2500);
        }
      } catch (e) {
        console.error('Clipboard copy error:', e);
      }
    }
  });

  // 3. Tactile Copy GPS Coordinates Action
  const copyGpsBtn = document.getElementById('copy-gps-btn');
  const gpsIcon = document.getElementById('gps-icon');
  const gpsText = document.getElementById('gps-text');

  copyGpsBtn?.addEventListener('click', async () => {
    const gps = copyGpsBtn.getAttribute('data-gps') || '';
    if (gps && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(gps);
        if (gpsIcon && gpsText) {
          gpsIcon.textContent = 'check_circle';
          gpsIcon.classList.add('text-emerald-600');
          const originalText = gpsText.textContent;
          gpsText.textContent = 'GPS Disalin!';

          setTimeout(() => {
            gpsIcon.textContent = 'my_location';
            gpsIcon.classList.remove('text-emerald-600');
            gpsText.textContent = originalText;
          }, 2500);
        }
      } catch (e) {
        console.error('GPS copy error:', e);
      }
    }
  });
</script>

