---
// src/components/GalleryLightbox.astro
// Clean Architectural Gallery: Seamless, Borderless Visual Grid + Pure Cinema Lightbox
---

<!-- ==================== SEKSI GALERI ARSITEKTURAL ==================== -->
<section class="py-20 sm:py-28 bg-surface-canvas border-b border-stone-200/60 scroll-mt-20 relative overflow-hidden" id="galeri">
  
  <!-- Subtle Ambient Luxury Glows -->
  <div class="absolute top-1/4 -right-32 w-96 h-96 rounded-full bg-syariah-gold/5 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 -left-32 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 xs:px-6 lg:px-10 relative z-10">
    
    <!-- Section Header (Clean, Minimalist, No Lines) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10 sm:mb-12">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-medium tracking-[0.2em] uppercase bg-syariah-gold/15 text-syariah-gold mb-2.5">
          Galeri Foto Properti
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-on-surface tracking-tight">
          Suasana &amp; Ruangan
        </h2>
      </div>

      <!-- Category Filter Bar with Left & Right Arrow Buttons -->
      <div class="flex items-center gap-1.5 sm:gap-2 max-w-full">
        <!-- Left Arrow Button -->
        <button 
          id="gallery-filter-prev" 
          type="button"
          aria-label="Geser Kategori ke Kiri"
          class="w-8 h-8 rounded-full bg-stone-200/70 hover:bg-stone-300 text-stone-700 flex items-center justify-center transition-all duration-200 active:scale-90 cursor-pointer shrink-0 shadow-2xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>

        <!-- Scrollable Category Filter Pills -->
        <div id="gallery-filter-scroll" class="overflow-x-auto no-scrollbar scroll-smooth py-1 flex-1 min-w-0">
          <div class="inline-flex p-1 rounded-full bg-stone-200/50 gap-1">
            <button 
              type="button"
              data-filter="all" 
              class="gallery-filter-btn active px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 bg-primary text-white shadow-xs whitespace-nowrap cursor-pointer active:scale-[0.96]"
            >
              Semua (9)
            </button>
            <button 
              type="button"
              data-filter="kamar" 
              class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 text-stone-600 hover:text-primary hover:bg-white/80 whitespace-nowrap cursor-pointer active:scale-[0.96]"
            >
              Kamar Tidur (3)
            </button>
            <button 
              type="button"
              data-filter="ibadah" 
              class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 text-stone-600 hover:text-primary hover:bg-white/80 whitespace-nowrap cursor-pointer active:scale-[0.96]"
            >
              Mushola &amp; Sanitasi (2)
            </button>
            <button 
              type="button"
              data-filter="outdoor" 
              class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all duration-300 text-stone-600 hover:text-primary hover:bg-white/80 whitespace-nowrap cursor-pointer active:scale-[0.96]"
            >
              Fasilitas &amp; Luar (4)
            </button>
          </div>
        </div>

        <!-- Right Arrow Button -->
        <button 
          id="gallery-filter-next" 
          type="button"
          aria-label="Geser Kategori ke Kanan"
          class="w-8 h-8 rounded-full bg-stone-200/70 hover:bg-stone-300 text-stone-700 flex items-center justify-center transition-all duration-200 active:scale-90 cursor-pointer shrink-0 shadow-2xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- ==================== CLEAN BALANCED GRID (HARMONIOUS 3-COLUMN, NO BORDER LINES) ==================== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="gallery-mosaic">
      
      <!-- 1. Kamar Lantai Bawah -->
      <article 
        class="mosaic-item group cursor-pointer"
        data-category="kamar"
        data-index="0"
      >
        <!-- Pure Borderless Photo Frame -->
        <div class="relative aspect-[16/10] rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-100 shadow-sm group-hover:shadow-xl transition-all duration-500 group-hover:-translate-y-1">
          <img 
            src="/image/Kamar-lantai-bawah.webp" 
            alt="Kamar Tidur Lantai Bawah Queen Bed 160 Grha Vege Jawi"
            class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
            <span class="w-11 h-11 rounded-full bg-white/95 text-primary-deep flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300 shadow-md">
              <span class="material-symbols-outlined text-[22px]">zoom_in</span>
            </span>
          </div>
        </div>

        <div class="mt-3 px-0.5">
          <h3 class="font-serif text-base sm:text-lg font-normal text-on-surface group-hover:text-primary transition-colors leading-snug">
            Kamar Lantai Bawah (Queen Bed 160)
          </h3>
        </div>
