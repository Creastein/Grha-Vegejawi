---
// src/components/GalleryLightbox.astro
---

<!-- ==================== GALERI SUASANA REALISTIS & LIGHTBOX ==================== -->
<section class="py-24 bg-surface-canvas border-b border-border-stone" id="galeri">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <span class="text-[11px] uppercase font-mono tracking-widest text-syariah-gold font-semibold">Dokumentasi Autentik</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-on-surface mt-2 tracking-tight">
          Galeri Suasana Grha Vege Jawi
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-on-surface-variant max-w-md text-justify">
        Foto nyata tanpa rekayasa sudut visual yang berlebihan. Ruangan rapi, wangi, dan tertata apa adanya untuk ketenangan istirahat Anda.
      </p>
    </div>

    <!-- Gallery Category Tabs -->
    <div class="flex flex-wrap items-center gap-2 mb-8 pb-3 border-b border-border-stone/60">
      <button data-filter="all" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-primary text-white shadow-xs">
        Semua Foto (9)
      </button>
      <button data-filter="ground" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white text-on-surface-variant hover:text-primary border border-border-stone">
        Kamar Bawah
      </button>
      <button data-filter="upper" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white text-on-surface-variant hover:text-primary border border-border-stone">
        Kamar Atas (3)
      </button>
      <button data-filter="mushola" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white text-on-surface-variant hover:text-primary border border-border-stone">
        Mushola
      </button>
      <button data-filter="bathroom" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white text-on-surface-variant hover:text-primary border border-border-stone">
        Kamar Mandi
      </button>
      <button data-filter="outdoor" class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-white text-on-surface-variant hover:text-primary border border-border-stone">
        Balkon &amp; Fasilitas
      </button>
    </div>

    <!-- Curated Visual Grid with Real Property Images -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="gallery-grid">
      
      <!-- Item 1: Kamar Lantai Bawah (Bed 160 Queen / Akses Parkir) -->
      <div class="gallery-item md:col-span-2 bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="ground" data-src="/image/Kamar-lantai-bawah.webp" data-title="Kamar Lantai Bawah (Bed 160 Queen / Kamar 6)" data-desc="Kamar tidur lantai bawah ber-AC dengan ranjang queen bed 160, meja rias ukir wayang jati, dan pintu akses datar langsung ke carport">
        <div class="bezel-core overflow-hidden relative aspect-[16/10] bg-surface-muted">
          <img alt="Kamar Tidur Lantai Bawah Grha Vege Jawi Syariah Bed 160 Queen" class="w-full h-full object-cover transition-transform duration-700 ease-magnetic group-hover:scale-105" src="/image/Kamar-lantai-bawah.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-5 left-6 right-6 text-white flex items-end justify-between">
            <div>
              <p class="font-serif text-lg font-normal">Kamar Lantai Bawah (Bed 160 Queen)</p>
              <p class="text-xs text-white/80 font-sans mt-0.5">Ranjang Queen, meja rias jati ukir wayang, &amp; pintu akses langsung ke mobil</p>
            </div>
            <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white">
              <span class="material-symbols-outlined text-[18px]">zoom_in</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Item 2: Kamar Lantai Atas (Bed 160 Queen / Kisi Kayu Modern) -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="upper" data-src="/image/kamar-lantai-atas-160.webp" data-title="Kamar Lantai Atas (Bed 160 / Kisi Kayu)" data-desc="Kamar tidur lantai atas bernuansa modern elegan dengan backdrop panel kisi-kisi kayu vertikal, kasur queen empuk, AC, dan TV dinding">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Kamar Lantai Atas Bed 160 Kisi Kayu Modern Grha Vege Jawi Syariah" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/kamar-lantai-atas-160.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Kamar Lt. Atas (Bed 160)</p>
              <span class="text-[10px] font-mono text-gold-soft">Backdrop Kisi Kayu</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 3: Kamar Lantai Atas (Bed 140 / Meja Kerja & TV) -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="upper" data-src="/image/Kamar-lantai-atas-140.webp" data-title="Kamar Lantai Atas (Bed 140 / Meja Kerja)" data-desc="Kamar tidur lantai atas ber-AC dengan bed 140, meja kerja/tulis lengkap air mineral &amp; cangkir, TV dinding, dan lemari pakaian cermin">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Kamar Tidur Lantai Atas Bed 140 Grha Vege Jawi Syariah" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/Kamar-lantai-atas-140.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Kamar Lt. Atas (Bed 140)</p>
              <span class="text-[10px] font-mono text-gold-soft">Meja Kerja &amp; TV</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 4: Mushola Bersih Khusus Tamu -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="mushola" data-src="/image/mushola.webp" data-title="Mushola Syariah Bersih" data-desc="Karpet sajadah hijau suci memanjang, terawat, penunjuk arah kiblat akurat, dan mosaik batik asri di dalam rumah">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Mushola Syariah Khusus Tamu Bersih" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/mushola.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Mushola Syariah Bersih</p>
              <span class="text-[10px] font-mono text-gold-soft">Khusus Tamu</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 5: Kamar Mandi Dalam & Water Heater -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="bathroom" data-src="/image/KM-Lantai-bawah.webp" data-title="KM Dalam &amp; Water Heater" data-desc="Sanitasi higienis dengan kloset duduk, shower air hangat gas 24 jam, dan wastafel cermin">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Kamar Mandi Dalam Kloset Duduk dan Water Heater" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/KM-Lantai-bawah.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">KM Dalam &amp; Water Heater</p>
              <span class="text-[10px] font-mono text-white/80">Higienis 24 Jam</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 6: Balkon & Area Duduk Lantai Atas -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="upper outdoor" data-src="/image/balkon-lantai-atas.webp" data-title="Balkon &amp; Kursi Ukir Jati Atas" data-desc="Area santai lantai atas berlantai bersih dengan sofa ukir Jepara megah, meja kaca, dan lampu gantung antik Jawa">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Balkon dan Kursi Sofa Ukir Jati Lantai Atas" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/balkon-lantai-atas.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Balkon &amp; Kursi Ukir Jati</p>
              <span class="text-[10px] font-mono text-white/80">Lantai Atas</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 7: Pendopo & Parkir Mobil Dalam Pagar -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="outdoor" data-src="/image/parkir-pendopo.webp" data-title="Pendopo Joglo &amp; Parkir Pagar" data-desc="Pendopo bernuansa Jawa dengan tiang kayu jati ukir dan jalur paving mobil aman dalam pagar gerbang tertutup">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Pendopo Joglo dan Parkir Mobil Aman di Dalam Pagar" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/parkir-pendopo.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Pendopo &amp; Parkir Mobil</p>
              <span class="text-[10px] font-mono text-white/80">Aman Dalam Pagar</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 8: Fasad Tampak Depan Properti -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="outdoor" data-src="/image/hero-section.webp" data-title="Fasad Grha Vege Jawi Syariah" data-desc="Tampak depan guesthouse resmi dengan pilar batu alam, plang neon box merah, dan pepohonan asri">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Fasad Bangunan Grha Vege Jawi Syariah" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/hero-section.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Fasad Tampak Depan</p>
              <span class="text-[10px] font-mono text-white/80">Neon Box Resmi</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

      <!-- Item 9: Gerbang Masuk & Pagar Keamanan -->
      <div class="gallery-item bezel-shell p-1.5 shadow-xs cursor-pointer group" data-category="outdoor" data-src="/image/gerbang-masuk.webp" data-title="Gerbang Masuk &amp; Pagar Keamanan" data-desc="Pintu gerbang masuk kokoh berpagar dengan atap Joglo dan papan nama resmi Griya Vege Jawi Syariah">
        <div class="bezel-core overflow-hidden relative aspect-[4/3] bg-surface-muted">
          <img alt="Gerbang Masuk Griya Vege Jawi Syariah" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="/image/gerbang-masuk.webp"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-3.5 left-4 right-4 text-white flex items-center justify-between">
            <div>
              <p class="font-serif text-sm font-medium">Gerbang Masuk &amp; Pagar</p>
              <span class="text-[10px] font-mono text-white/80">Aman &amp; Terjaga</span>
            </div>
            <span class="material-symbols-outlined text-[16px] text-white/80">zoom_in</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ==================== LIGHTBOX MODAL ==================== -->
<div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-8">
  <div class="relative max-w-4xl w-full flex flex-col items-center">
    <button id="lightbox-close" aria-label="Tutup Foto" class="absolute -top-12 right-0 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
    <div class="w-full max-h-[75vh] overflow-hidden rounded-2xl border border-white/15 bg-black/40 flex items-center justify-center">
      <img id="lightbox-img" src="" alt="Foto Pembesaran" class="max-h-[75vh] w-auto object-contain"/>
    </div>
    <div class="mt-4 text-center text-white">
      <h4 id="lightbox-title" class="font-serif text-xl font-normal"></h4>
      <p id="lightbox-desc" class="text-xs text-white/70 mt-1 font-sans"></p>
    </div>
  </div>
</div>

<script>
  // Interactive Gallery Filter & Lightbox Engine
  const galleryBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxDesc = document.getElementById('lightbox-desc');
  const lightboxClose = document.getElementById('lightbox-close');

  galleryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      galleryBtns.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'shadow-xs');
        b.classList.add('bg-white', 'text-on-surface-variant', 'border', 'border-border-stone');
      });
      btn.classList.add('bg-primary', 'text-white', 'shadow-xs');
      btn.classList.remove('bg-white', 'text-on-surface-variant');

      galleryItems.forEach(item => {
        const category = item.getAttribute('data-category') || '';
        const categories = category.split(' ');
        if (filter === 'all' || categories.includes(filter)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });

  // Lightbox open
  galleryItems.forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      const title = item.getAttribute('data-title');
      const desc = item.getAttribute('data-desc');

      if (lightboxImg && lightboxTitle && lightboxDesc && lightboxModal && src) {
        lightboxImg.src = src;
        lightboxTitle.textContent = title || '';
        lightboxDesc.textContent = desc || '';
        lightboxModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  // Lightbox close
  function closeLightbox() {
    if (lightboxModal) {
      lightboxModal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }
  if (lightboxModal) {
    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal) closeLightbox();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
