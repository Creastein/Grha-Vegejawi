<!-- ==================== THEATER LIGHTBOX MODAL (PURE CINEMA VIEW - CUMAN JUDUL SAJA) ==================== -->
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-2xl flex flex-col justify-between p-4 sm:p-6 lg:p-8 select-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Penampil Foto Galeri"
>
  
  <!-- Top Bar: Clean Counter Capsule & Close Button -->
  <div class="w-full max-w-6xl mx-auto flex items-center justify-between z-10 pt-1">
    <div class="flex items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-white text-xs font-mono">
        Foto <strong id="lightbox-counter-curr" class="text-syariah-gold font-semibold">1</strong> dari <span id="lightbox-counter-total">9</span>
      </span>
    </div>

    <button 
      id="lightbox-close" 
      type="button"
      aria-label="Tutup Penampil Foto (Esc)" 
      class="w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all duration-300 hover:rotate-90 cursor-pointer active:scale-95 shadow-sm"
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
  </div>

  <!-- Center Stage: Main Image & Prev / Next Controls (No Borders, Max Height) -->
  <div class="relative w-full max-w-5xl mx-auto flex-1 flex items-center justify-center py-2 sm:py-4">
    
    <!-- Prev Arrow Button -->
    <button 
      id="lightbox-prev"
      type="button"
      aria-label="Foto Sebelumnya (Panah Kiri)"
      class="absolute left-0 sm:-left-4 lg:-left-6 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-black/70 hover:bg-black text-white backdrop-blur-md flex items-center justify-center transition-all duration-200 active:scale-90 hover:scale-105 cursor-pointer shadow-xl"
    >
      <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_left</span>
    </button>

    <!-- Photo Container -->
    <div class="relative max-h-[82vh] w-auto max-w-full flex items-center justify-center overflow-hidden rounded-2xl sm:rounded-3xl shadow-2xl">
      <img 
        id="lightbox-img" 
        src="" 
        alt="Foto Galeri Grha Vege Jawi" 
        class="max-h-[80vh] w-auto max-w-full object-contain rounded-2xl transition-transform duration-300"
      />
    </div>

    <!-- Next Arrow Button -->
    <button 
      id="lightbox-next"
      type="button"
      aria-label="Foto Selanjutnya (Panah Kanan)"
      class="absolute right-0 sm:-right-4 lg:-right-6 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-black/70 hover:bg-black text-white backdrop-blur-md flex items-center justify-center transition-all duration-200 active:scale-90 hover:scale-105 cursor-pointer shadow-xl"
    >
      <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_right</span>
    </button>

  </div>

  <!-- Bottom Bar: Cuman Judul Saja (Pure & Clean) -->
  <div class="w-full max-w-3xl mx-auto text-center text-white pb-3 z-10">
    <h3 id="lightbox-title" class="font-serif text-lg sm:text-2xl font-normal tracking-wide text-white/95"></h3>
  </div>

</div>

<!-- Interactive Client-side Script: Lightbox & Filtering -->
<script>
  interface PhotoItem {
    src: string;
    title: string;
    category: string;
  }

  const galleryData: PhotoItem[] = [
    {
      src: "/image/Kamar-lantai-bawah.webp",
      title: "Kamar Lantai Bawah (Queen Bed 160)",
      category: "kamar"
    },
    {
      src: "/image/kamar-lantai-atas-160.webp",
      title: "Kamar Lantai Atas (Bed 160)",
      category: "kamar"
    },
    {
      src: "/image/Kamar-lantai-atas-140.webp",
      title: "Kamar Lantai Atas (Bed 140 & Meja Kerja)",
      category: "kamar"
    },
    {
      src: "/image/mushola.webp",
      title: "Mushola Syariah Tamu",
      category: "ibadah"
    },
    {
      src: "/image/KM-Lantai-bawah.webp",
      title: "Kamar Mandi Dalam & Water Heater",
      category: "ibadah"
    },
    {
      src: "/image/balkon-lantai-atas.webp",
      title: "Balkon & Sofa Jati Lantai Atas",
      category: "outdoor"
    },
    {
      src: "/image/parkir-pendopo.webp",
      title: "Pendopo Joglo & Parkir Mobil",
      category: "outdoor"
    },
    {
      src: "/image/hero-section.webp",
      title: "Fasad Tampak Depan Properti",
      category: "outdoor"
    },
    {
      src: "/image/gerbang-masuk.webp",
      title: "Gerbang Masuk & Pagar Keamanan",
      category: "outdoor"
    }
  ];

  // DOM Elements
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
  const mosaicItems = document.querySelectorAll<HTMLElement>('.mosaic-item');

  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxCounterCurr = document.getElementById('lightbox-counter-curr');
  const lightboxCounterTotal = document.getElementById('lightbox-counter-total');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentLightboxIndex = 0;

  if (lightboxCounterTotal) {
    lightboxCounterTotal.textContent = galleryData.length.toString();
  }

  // Render Lightbox State
  function renderLightbox(index: number) {
    if (index < 0) index = galleryData.length - 1;
    if (index >= galleryData.length) index = 0;
    currentLightboxIndex = index;

    const item = galleryData[currentLightboxIndex];
    if (!item) return;

    if (lightboxImg) lightboxImg.src = item.src;
    if (lightboxTitle) lightboxTitle.textContent = item.title;
    if (lightboxCounterCurr) lightboxCounterCurr.textContent = (currentLightboxIndex + 1).toString();
  }

  function openLightbox(index: number) {
    renderLightbox(index);
    if (lightboxModal) {
      lightboxModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    if (lightboxModal) {
      lightboxModal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  // Connect Items to Lightbox
  mosaicItems.forEach(item => {
    item.addEventListener('click', () => {
      const idx = parseInt(item.getAttribute('data-index') || '0', 10);
      openLightbox(idx);
    });
  });

  // Prev / Next Controls
  if (lightboxPrev) {
    lightboxPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      renderLightbox(currentLightboxIndex - 1);
    });
  }

  if (lightboxNext) {
    lightboxNext.addEventListener('click', (e) => {
      e.stopPropagation();
      renderLightbox(currentLightboxIndex + 1);
    });
  }

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightboxModal) {
    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal) closeLightbox();
    });
  }

  // Keyboard navigation: Escape, ArrowLeft, ArrowRight
  document.addEventListener('keydown', (e) => {
    if (!lightboxModal || lightboxModal.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      renderLightbox(currentLightboxIndex - 1);
    } else if (e.key === 'ArrowRight') {
      renderLightbox(currentLightboxIndex + 1);
    }
  });

  // Mobile Touch Swipe support
  let touchStartX = 0;
  let touchEndX = 0;

  if (lightboxModal) {
    lightboxModal.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightboxModal.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          renderLightbox(currentLightboxIndex - 1);
        } else {
          renderLightbox(currentLightboxIndex + 1);
        }
      }
    }, { passive: true });
  }

  // Category Scroll Buttons (Pojok Kiri & Kanan)
  const filterScroll = document.getElementById('gallery-filter-scroll');
  const filterPrev = document.getElementById('gallery-filter-prev');
  const filterNext = document.getElementById('gallery-filter-next');

  if (filterPrev && filterScroll) {
    filterPrev.addEventListener('click', () => {
      filterScroll.scrollBy({ left: -150, behavior: 'smooth' });
    });
  }

  if (filterNext && filterScroll) {
    filterNext.addEventListener('click', () => {
      filterScroll.scrollBy({ left: 150, behavior: 'smooth' });
    });
  }

  // Category Filtering
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Scroll selected button into center view
      btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

      // Update active button state
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-primary', 'text-white', 'shadow-xs');
        b.classList.add('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');
      });
      btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-xs');
      btn.classList.remove('text-stone-600', 'hover:text-primary', 'hover:bg-white/80');

      // Filter Cards
      mosaicItems.forEach(item => {
        const cat = item.getAttribute('data-category') || '';
        if (filter === 'all' || cat === filter) {
          item.classList.remove('hidden');
          item.classList.add('block');
        } else {
          item.classList.add('hidden');
          item.classList.remove('block');
        }
      });
    });
  });
</script>
