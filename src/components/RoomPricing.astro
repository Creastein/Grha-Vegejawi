<!-- Client Script for Interactive Tabbing & Photo Switching -->
<script>
  // 1. Stay Type Switcher (Harian vs Bulanan vs Full House)
  const stayTabs = document.querySelectorAll<HTMLButtonElement>('.stay-type-tab');
  const stayPanels = document.querySelectorAll<HTMLElement>('.stay-panel');

  stayTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab-target');

      // Update Tab Buttons
      stayTabs.forEach(t => {
        t.classList.remove('active', 'bg-primary', 'text-white', 'shadow-xs');
        t.classList.add('text-stone-700', 'hover:text-primary', 'hover:bg-white/60');
      });
      tab.classList.add('active', 'bg-primary', 'text-white', 'shadow-xs');
      tab.classList.remove('text-stone-700', 'hover:text-primary', 'hover:bg-white/60');

      // Show Selected Panel
      stayPanels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    });
  });

  // 2. Upper Floor Photo Selector (Bed 160 vs Bed 140 vs Balkon)
  const upperPhotoBtns = document.querySelectorAll<HTMLButtonElement>('.upper-photo-btn');
  const upperImg = document.getElementById('upper-floor-img') as HTMLImageElement | null;

  upperPhotoBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const newPhoto = btn.getAttribute('data-photo');
      if (upperImg && newPhoto) {
        upperImg.src = newPhoto;

        upperPhotoBtns.forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white', 'shadow-2xs');
          b.classList.add('bg-stone-100', 'text-stone-600');
        });
        btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-stone-100', 'text-stone-600');
      }
    });
  });
</script>
