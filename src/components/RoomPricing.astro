---
// src/components/RoomPricing.astro
// High-End, UI/UX Friendly Room & Pricing Showcase for Desktop and Mobile
import { type PricingData, formatRupiah } from '../lib/pricing';

interface Props {
  pricing: PricingData;
}

const { pricing } = Astro.props;

const dailyFormatted = formatRupiah(pricing.weekdayPrice);
const monthlyFormatted = formatRupiah(pricing.monthlyPrice);

const waGroundLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya dari website Grha Vege Jawi, ingin tanya ketersediaan dan pesan Kamar Lantai Bawah (mulai ${dailyFormatted}/malam)`)}`;
const waUpperLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya dari website Grha Vege Jawi, ingin tanya ketersediaan dan pesan Kamar Lantai Atas (mulai ${dailyFormatted}/malam)`)}`;
const waMonthlyLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya dari website Grha Vege Jawi, ingin tanya ketersediaan sewa Kamar Bulanan (mulai ${monthlyFormatted}/bulan)`)}`;
const waFullHouseLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya dari website Grha Vege Jawi, ingin tanya ketersediaan sewa Full House (6 Kamar Rombongan)`)}`;
const waConsultLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya dari website Grha Vege Jawi, ingin konsultasi kebutuhan menginap`)}`;
---

<!-- ==================== KAMAR & TARIF TERPADU (UI/UX FRIENDLY) ==================== -->
<section class="py-16 sm:py-24 bg-surface-subtle/50 border-b border-border-stone scroll-mt-20 relative overflow-hidden" id="kamar">
  
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-10 -left-40 w-96 h-96 rounded-full bg-syariah-gold/5 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 -right-40 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 xs:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Header Section: Clean, Welcoming, Clear Value -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-semibold tracking-[0.2em] uppercase bg-syariah-gold/10 text-syariah-gold-dark border border-syariah-gold/30 mb-3">
        Pilihan Kamar &amp; Tarif
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-on-surface tracking-tight">
        Kenyamanan Istirahat &amp; Tarif Jujur
      </h2>
      <p class="text-on-surface-variant text-xs xs:text-sm sm:text-base mt-2.5 leading-relaxed">
        Total 6 kamar privat ber-AC dengan kamar mandi dalam. Pilih sewa harian per kamar, kost bulanan, atau sewa seluruh rumah untuk rombongan keluarga.
      </p>

      {pricing.promoBanner && (
        <div class="mt-3.5 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-syariah-gold/15 text-primary-deep border border-syariah-gold/30 text-xs font-mono font-medium shadow-2xs">
          <span class="material-symbols-outlined text-[16px] text-syariah-gold-dark" aria-hidden="true">campaign</span>
          <span>{pricing.promoBanner}</span>
        </div>
      )}
    </div>

    <!-- 2. Main Intent Switcher Tabs: Harian vs Bulanan vs Full House (Double-Bezel Track) -->
    <div class="w-full max-w-md mx-auto mb-8 sm:mb-10 px-2" id="tarif">
      <div class="p-1.5 rounded-full bg-stone-200/70 ring-1 ring-stone-300/80 shadow-inner grid grid-cols-3 gap-1">
        <button 
          type="button"
          data-tab-target="daily-panel"
          class="stay-type-tab active w-full py-2.5 px-3 rounded-full text-xs sm:text-sm font-mono font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] flex items-center justify-center gap-1.5 bg-primary text-white shadow-xs cursor-pointer text-center whitespace-nowrap active:scale-[0.98]"
        >
          <span class="material-symbols-outlined text-[16px] shrink-0" aria-hidden="true">hotel</span>
          <span>Harian</span>
        </button>

        <button 
          type="button"
          data-tab-target="monthly-panel"
          class="stay-type-tab w-full py-2.5 px-3 rounded-full text-xs sm:text-sm font-mono font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] flex items-center justify-center gap-1.5 text-stone-700 hover:text-primary hover:bg-white/60 cursor-pointer text-center whitespace-nowrap active:scale-[0.98]"
        >
          <span class="material-symbols-outlined text-[16px] shrink-0" aria-hidden="true">calendar_month</span>
          <span>Bulanan</span>
        </button>

        <button 
          type="button"
          data-tab-target="fullhouse-panel"
          class="stay-type-tab w-full py-2.5 px-3 rounded-full text-xs sm:text-sm font-mono font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] flex items-center justify-center gap-1.5 text-stone-700 hover:text-primary hover:bg-white/60 cursor-pointer text-center whitespace-nowrap active:scale-[0.98]"
        >
          <span class="material-symbols-outlined text-[16px] shrink-0" aria-hidden="true">groups</span>
          <span>Full House</span>
        </button>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- PANEL 1: SEWA HARIAN (DEFAULT ACTIVE) -->
    <!-- ========================================================================= -->
    <div id="daily-panel" class="stay-panel block transition-opacity duration-300">
      
      <!-- Cards Grid: Side-by-side di Desktop, Natural Stack di Mobile (UI/UX Friendly Tanpa Toggle Tersembunyi) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        
        <!-- CARD 1: LANTAI BAWAH -->
        <article class="p-2 sm:p-2.5 rounded-[2.5rem] bg-stone-200/40 ring-1 ring-stone-300/60 hover:ring-syariah-gold/35 hover:bg-syariah-gold/5 shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_24px_50px_-12px_rgba(40,54,43,0.15)] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 flex flex-col justify-between">
          <div class="rounded-[calc(2.5rem-0.5rem)] bg-white overflow-hidden shadow-[inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col justify-between h-full">
            <div>
              <!-- Photo Container -->
              <div class="relative aspect-[16/10] bg-stone-100 overflow-hidden group">
                <img 
                  src="/image/Kamar-lantai-bawah.webp" 
                  alt="Kamar Lantai Bawah Grha Vege Jawi Syariah"
                  class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="1089"
                />
                <span class="absolute top-3.5 left-3.5 bg-black/65 backdrop-blur-md text-white text-[11px] font-mono px-3 py-1 rounded-full border border-white/15 flex items-center gap-1.5 shadow-xs">
                  <span class="material-symbols-outlined text-[13px] text-emerald-400">check_circle</span>
                  <span>Lantai 1 • 2 Unit</span>
                </span>
                <span class="absolute top-3.5 right-3.5 bg-syariah-gold/90 backdrop-blur-md text-primary-deep text-[11px] font-mono font-semibold px-2.5 py-1 rounded-full shadow-xs">
                  Ramah Lansia
                </span>
              </div>

              <!-- Room Content -->
              <div class="p-5 sm:p-7">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-serif text-xl sm:text-2xl font-normal text-on-surface">Kamar Lantai Bawah</h3>
                  <span class="text-[11px] font-mono text-stone-600 font-medium">Queen Bed 160</span>
                </div>
                
                <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed">
                  Akses datar ramah lansia tanpa tangga. Dekat carport, mushola, ruang tamu, dan dapur mini keluarga.
                </p>

                <!-- Key Specs (2x2 Grid with Subtle Pills) -->
                <div class="mt-4 pt-4 border-t border-stone-100 grid grid-cols-2 gap-2 text-xs text-stone-600 font-mono">
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">king_bed</span>
                    <span>Queen Bed 160</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">shower</span>
                    <span>KM Dalam &amp; Heater</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">ac_unit</span>
                    <span>AC Dingin &amp; TV</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">meeting_room</span>
                    <span>Dekat Carport</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer: Strategic Pricing & Direct Booking Bar -->
            <div class="p-5 sm:p-7 pt-0">
              <div class="pt-4 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] font-mono uppercase text-stone-600 block font-medium">Mulai dari:</span>
                  <div class="flex items-baseline gap-1">
                    <span class="font-serif text-xl sm:text-2xl font-normal text-primary">{dailyFormatted}</span>
                    <span class="text-[10px] font-mono text-stone-600 font-medium">/malam</span>
                  </div>
                </div>

                <a 
                  href={waGroundLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn inline-flex items-center justify-between gap-2.5 bg-primary hover:bg-primary-deep text-white pl-4 pr-1.5 py-1.5 rounded-full text-xs font-mono font-medium shadow-xs hover:shadow-md transition-all duration-300 active:scale-[0.98] shrink-0"
                >
                  <span>Pesan Lantai 1</span>
                  <span class="w-7 h-7 rounded-full bg-white/15 group-hover/btn:bg-syariah-gold group-hover/btn:text-primary-deep flex items-center justify-center text-white transition-all duration-300 group-hover/btn:translate-x-0.5 shrink-0" aria-hidden="true">
                    <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- CARD 2: LANTAI ATAS -->
        <article class="p-2 sm:p-2.5 rounded-[2.5rem] bg-stone-200/40 ring-1 ring-stone-300/60 hover:ring-syariah-gold/35 hover:bg-syariah-gold/5 shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_24px_50px_-12px_rgba(40,54,43,0.15)] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 flex flex-col justify-between">
          <div class="rounded-[calc(2.5rem-0.5rem)] bg-white overflow-hidden shadow-[inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col justify-between h-full">
            <div>
              <!-- Photo Container with Interactive View Selector -->
              <div class="relative aspect-[16/10] bg-stone-100 overflow-hidden group">
                <img 
                  id="upper-floor-img"
                  src="/image/kamar-lantai-atas-160.webp" 
                  alt="Kamar Lantai Atas Grha Vege Jawi Syariah"
                  class="w-full h-full object-cover transition-all duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="1067"
                />
                <span class="absolute top-3.5 left-3.5 bg-black/65 backdrop-blur-md text-white text-[11px] font-mono px-3 py-1 rounded-full border border-white/15 flex items-center gap-1.5 shadow-xs">
                  <span class="material-symbols-outlined text-[13px] text-syariah-gold" aria-hidden="true">deck</span>
                  <span>Lantai 2 • 4 Unit</span>
                </span>
                <span class="absolute top-3.5 right-3.5 bg-emerald-800/90 backdrop-blur-md text-white text-[11px] font-mono font-medium px-2.5 py-1 rounded-full shadow-xs">
                  Balkon &amp; Meja Kerja
                </span>
              </div>

              <!-- Interactive Photo Switcher Chips -->
              <div class="px-5 sm:px-7 pt-3 flex flex-wrap items-center gap-2 text-[10px] sm:text-[11px] font-mono">
                <span class="text-stone-600 font-medium">Lihat Sudut:</span>
                <button 
                  type="button" 
                  data-photo="/image/kamar-lantai-atas-160.webp"
                  class="upper-photo-btn active min-h-[38px] px-3.5 py-1.5 inline-flex items-center justify-center rounded-full bg-primary text-white transition-all duration-200 cursor-pointer shadow-2xs"
                >
                  Bed 160
                </button>
                <button 
                  type="button" 
                  data-photo="/image/Kamar-lantai-atas-140.webp"
                  class="upper-photo-btn min-h-[38px] px-3.5 py-1.5 inline-flex items-center justify-center rounded-full bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all duration-200 cursor-pointer font-medium"
                >
                  Bed 140
                </button>
                <button 
                  type="button" 
                  data-photo="/image/balkon-lantai-atas.webp"
                  class="upper-photo-btn min-h-[38px] px-3.5 py-1.5 inline-flex items-center justify-center rounded-full bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all duration-200 cursor-pointer font-medium"
                >
                  Balkon
                </button>
              </div>

              <!-- Room Content -->
              <div class="p-5 sm:p-7 pt-3 sm:pt-4">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-serif text-xl sm:text-2xl font-normal text-on-surface">Kamar Lantai Atas</h3>
                  <span class="text-[11px] font-mono text-stone-600 font-medium">Bed 160 / 140</span>
                </div>
                
                <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed">
                  Suasana hening dengan semilir angin balkon. Dilengkapi opsi meja kerja pribadi dan koridor bersantai sofa ukir jati.
                </p>

                <!-- Key Specs (2x2 Grid with Subtle Pills) -->
                <div class="mt-4 pt-4 border-t border-stone-100 grid grid-cols-2 gap-2 text-xs text-stone-600 font-mono">
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">bed</span>
                    <span>Bed 160 / 140</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">shower</span>
                    <span>KM Dalam &amp; Heater</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">laptop_mac</span>
                    <span>Meja Kerja Pribadi</span>
                  </div>
                  <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-100">
                    <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">deck</span>
                    <span>Balkon Sofa Jati</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer: Strategic Pricing & Direct Booking Bar -->
            <div class="p-5 sm:p-7 pt-0">
              <div class="pt-4 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] font-mono uppercase text-stone-600 block font-medium">Mulai dari:</span>
                  <div class="flex items-baseline gap-1">
                    <span class="font-serif text-xl sm:text-2xl font-normal text-primary">{dailyFormatted}</span>
                    <span class="text-[10px] font-mono text-stone-600 font-medium">/malam</span>
                  </div>
                </div>

                <a 
                  href={waUpperLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn inline-flex items-center justify-between gap-2.5 bg-primary hover:bg-primary-deep text-white pl-4 pr-1.5 py-1.5 rounded-full text-xs font-mono font-medium shadow-xs hover:shadow-md transition-all duration-300 active:scale-[0.98] shrink-0"
                >
                  <span>Pesan Lantai 2</span>
                  <span class="w-7 h-7 rounded-full bg-white/15 group-hover/btn:bg-syariah-gold group-hover/btn:text-primary-deep flex items-center justify-center text-white transition-all duration-300 group-hover/btn:translate-x-0.5 shrink-0">
                    <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </article>

      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- PANEL 2: KOST BULANAN (DOUBLE-BEZEL LUXURY) -->
    <!-- ========================================================================= -->
    <div id="monthly-panel" class="stay-panel hidden transition-opacity duration-300">
      <div class="p-2 sm:p-2.5 rounded-[2.5rem] bg-stone-200/40 ring-1 ring-stone-300/60 shadow-sm max-w-4xl mx-auto">
        <div class="rounded-[calc(2.5rem-0.5rem)] bg-white p-6 sm:p-10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.9)]">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-100">
            <div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-semibold uppercase bg-syariah-gold/15 text-primary-deep border border-syariah-gold/30 mb-2.5">
                Kost Privat Eksekutif
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-on-surface">
                Sewa Kamar Bulanan
              </h3>
              <p class="text-xs sm:text-sm text-on-surface-variant mt-1">
                Khusus mahasiswa pascasarjana, koas dokter, maupun pekerja dinas yang butuh hunian tenang &amp; tertib syariah.
              </p>
            </div>

            <div class="sm:text-right shrink-0">
              <span class="text-[11px] font-mono text-stone-600 font-medium block">Tarif Sewa Bulanan Mulai:</span>
              <div class="font-serif text-3xl font-medium text-primary">{monthlyFormatted}</div>
              <span class="text-[11px] font-mono text-stone-600 font-medium">/ kamar / bulan</span>
            </div>
          </div>

          <!-- Rincian Termasuk vs Mandiri -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
            <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200/60">
              <div class="flex items-center gap-2 text-emerald-900 font-mono font-semibold text-xs mb-3 uppercase tracking-wider">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">verified</span>
                <span>Sudah Termasuk Sewa:</span>
              </div>
              <ul class="space-y-2.5 text-xs font-mono text-emerald-950">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold">•</span>
                  <span>Kamar privat AC &amp; kamar mandi dalam</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold">•</span>
                  <span>Water heater, springbed, lemari, meja rias</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold">•</span>
                  <span>Gratis WiFi fiber kecepatan tinggi</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold">•</span>
                  <span>Akses dapur bersama, kulkas, &amp; dispenser</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-emerald-700 font-bold">•</span>
                  <span>Kebersihan area umum &amp; pembuangan sampah</span>
                </li>
              </ul>
            </div>

            <div class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200/60 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-amber-900 font-mono font-semibold text-xs mb-3 uppercase tracking-wider">
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">info</span>
                  <span>Biaya Pemakaian Mandiri:</span>
                </div>
                <ul class="space-y-2.5 text-xs font-mono text-amber-950">
                  <li class="flex items-start gap-2">
                    <span class="text-amber-700 font-bold">•</span>
                    <span><strong>Listrik Kamar:</strong> Beli token PLN sendiri sesuai pemakaian AC &amp; elektronik pribadi.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-amber-700 font-bold">•</span>
                    <span><strong>Gas Water Heater:</strong> Pengisian tabung gas air panas mandiri.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-amber-700 font-bold">•</span>
                    <span><strong>Pajak Daerah:</strong> Dibayarkan sendiri oleh penyewa kost.</span>
                  </li>
                </ul>
              </div>

              <div class="mt-4 pt-3 border-t border-amber-200/50 text-[11px] font-mono text-amber-950 font-medium">
                Transparan, adil, dan sesuai dengan pemakaian riil penghuni kos.
              </div>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-stone-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-xs font-mono text-stone-600 font-medium">
              Ketersediaan unit terbatas. Disarankan konfirmasi ketersediaan 1–2 minggu sebelumnya.
            </div>

            <a 
              href={waMonthlyLink}
              target="_blank"
              rel="noopener noreferrer"
              class="group/btn inline-flex items-center justify-between gap-3 bg-primary hover:bg-primary-deep text-white pl-6 pr-2 py-2 rounded-full text-xs font-mono font-medium shadow-xs hover:shadow-md transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] shrink-0"
            >
              <span>Tanya Ketersediaan Bulanan</span>
              <span class="w-8 h-8 rounded-full bg-white/15 group-hover/btn:bg-syariah-gold group-hover/btn:text-primary-deep flex items-center justify-center text-white transition-all duration-300 group-hover/btn:translate-x-0.5 shrink-0 shadow-2xs">
                <span class="material-symbols-outlined text-[15px]">chat</span>
              </span>
            </a>
          </div>

        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- PANEL 3: FULL HOUSE (EDITORIAL OLED LUXURY) -->
    <!-- ========================================================================= -->
    <div id="fullhouse-panel" class="stay-panel hidden transition-opacity duration-300">
      <div class="p-2 sm:p-2.5 rounded-[2.5rem] bg-stone-800/80 ring-1 ring-white/10 shadow-2xl max-w-4xl mx-auto">
        <div class="rounded-[calc(2.5rem-0.5rem)] bg-gradient-to-br from-stone-900 via-stone-900 to-stone-950 text-white p-6 sm:p-10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
          
