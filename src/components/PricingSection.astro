---
// src/components/PricingSection.astro
import { type PricingData, formatRupiah } from '../lib/pricing';

interface Props {
  pricing: PricingData;
}

const { pricing } = Astro.props;

const weekdayFormatted = formatRupiah(pricing.weekdayPrice);
const weekendFormatted = formatRupiah(pricing.weekendPrice);
const monthlyFormatted = formatRupiah(pricing.monthlyPrice);

const waWeekdayLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya ingin pesan kamar Weekday (${weekdayFormatted}) di Grha Vege Jawi`)}`;
const waWeekendLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya ingin pesan kamar Weekend (${weekendFormatted}) di Grha Vege Jawi`)}`;
const waMonthlyLink = `https://wa.me/628122729637?text=${encodeURIComponent(`Halo Ibu Agnesia, saya tertarik sewa Kamar Bulanan (${monthlyFormatted}) di Grha Vege Jawi`)}`;
---

<!-- ==================== SKEMA TARIF BERSIH & TRANSPARAN (RATE CARD HOSPITALITY) ==================== -->
<section class="py-20 sm:py-24 bg-surface-canvas border-b border-border-stone" id="tarif">
  <div class="max-w-7xl mx-auto px-4 xs:px-6 lg:px-10">
    
    <!-- Section Header (Clean & Direct) -->
    <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-14">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[10px] font-mono font-medium tracking-[0.2em] uppercase bg-syariah-gold/10 text-syariah-gold border border-syariah-gold/25">
        Hospitality Rate Card
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-on-surface mt-2.5 tracking-tight">
        Tarif Sewa Jujur &amp; Transparan
      </h2>
      <p class="text-xs sm:text-sm text-on-surface-variant mt-2 max-w-lg mx-auto leading-relaxed">
        Satu harga wajar tanpa biaya tersembunyi untuk kenyamanan istirahat Anda dan keluarga di Yogyakarta.
      </p>

      {pricing.promoBanner && (
        <div class="mt-4 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-syariah-gold/15 text-primary-deep border border-syariah-gold/30 text-xs font-mono font-medium shadow-xs">
          <span class="material-symbols-outlined text-[16px] text-syariah-gold">campaign</span>
          <span>{pricing.promoBanner}</span>
        </div>
      )}
    </div>

    <!-- 3-Column Authentic Architectural Rate Card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      
      <!-- Col 1: Weekday -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-[0_12px_35px_-10px_rgba(40,54,43,0.06)] border border-stone-200/80 hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-primary font-semibold">Weekday</span>
            <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-surface-subtle text-on-surface-variant border border-stone-200/80">Senin–Kamis</span>
          </div>
          <div class="mt-5">
            <div class="font-serif text-2xl sm:text-3xl font-normal text-on-surface">Mulai {weekdayFormatted}</div>
            <span class="text-[11px] text-on-surface-variant font-mono mt-0.5 block">/ kamar / malam (isi 2 orang)</span>
          </div>
          <p class="text-xs text-on-surface-variant mt-3.5 leading-relaxed">
            Pilihan pas untuk dinas kerja, kunjungan singkat kampus, maupun transit perjalanan di Yogyakarta.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5 text-[10px] font-mono text-primary">
            <span class="bg-primary-light px-2.5 py-0.5 rounded-full">All-Inclusive</span>
            <span class="bg-primary-light px-2.5 py-0.5 rounded-full">Gratis WiFi</span>
            <span class="bg-primary-light px-2.5 py-0.5 rounded-full">Parkir Mobil</span>
          </div>
        </div>
        <div class="mt-6 pt-5 border-t border-stone-100">
          <a 
            class="group/btn inline-flex items-center justify-between w-full py-2.5 pl-4 pr-1.5 text-xs font-mono font-medium rounded-full bg-surface-subtle hover:bg-primary text-primary hover:text-white border border-stone-300/80 hover:border-primary shadow-xs transition-all duration-300 active:scale-[0.98]" 
            href={waWeekdayLink} 
            rel="noopener noreferrer" 
            target="_blank"
          >
            <span>Pesan Weekday</span>
            <div class="w-7 h-7 rounded-full bg-white group-hover/btn:bg-white/20 text-primary group-hover/btn:text-white flex items-center justify-center transition-all duration-300">
              <span class="material-symbols-outlined text-[15px] group-hover/btn:translate-x-0.5 transition-transform">arrow_forward</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Col 2: Weekend & Long Weekend -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-[0_12px_35px_-10px_rgba(40,54,43,0.06)] border border-stone-200/80 hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-secondary font-semibold">Weekend</span>
            <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-surface-subtle text-on-surface-variant border border-stone-200/80">Jumat–Minggu</span>
          </div>
          <div class="mt-5">
            <div class="font-serif text-2xl sm:text-3xl font-normal text-on-surface">Mulai {weekendFormatted}</div>
            <span class="text-[11px] text-on-surface-variant font-mono mt-0.5 block">/ kamar / malam (isi 2 orang)</span>
          </div>
          <p class="text-xs text-on-surface-variant mt-3.5 leading-relaxed">
            Ideal bagi keluarga yang berlibur santai, menghadiri wisuda, maupun hajatan pernikahan di Yogyakarta.
          </p>
          <div class="mt-4 p-2.5 rounded-xl bg-amber-50/80 border border-amber-200/60 text-[10px] font-mono text-amber-800">
            <div class="flex items-center gap-1 font-semibold text-amber-900">
              <span class="material-symbols-outlined text-[13px]">event_repeat</span>
              <span>Long Weekend</span>
            </div>
            <span class="text-[10px] text-amber-750 block mt-0.5 leading-tight">Tarif libur nasional menyesuaikan ketersediaan (konfirmasi ke Bu Agnes).</span>
          </div>
        </div>
        <div class="mt-6 pt-5 border-t border-stone-100">
          <a 
            class="group/btn inline-flex items-center justify-between w-full py-2.5 pl-4 pr-1.5 text-xs font-mono font-medium rounded-full bg-surface-subtle hover:bg-secondary hover:text-white text-secondary border border-stone-300/80 hover:border-secondary shadow-xs transition-all duration-300 active:scale-[0.98]" 
            href={waWeekendLink} 
            rel="noopener noreferrer" 
            target="_blank"
          >
            <span>Pesan Weekend</span>
            <div class="w-7 h-7 rounded-full bg-white group-hover/btn:bg-white/20 text-secondary group-hover/btn:text-white flex items-center justify-center transition-all duration-300">
              <span class="material-symbols-outlined text-[15px] group-hover/btn:translate-x-0.5 transition-transform">arrow_forward</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Col 3: Bulanan (Kost Eksklusif) -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-[0_16px_40px_-10px_rgba(200,157,75,0.15)] border-2 border-syariah-gold relative flex flex-col justify-between hover:-translate-y-1 hover:shadow-xl transition-all duration-300 group">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-primary text-white text-[10px] font-mono uppercase tracking-widest px-3.5 py-0.5 rounded-full shadow-xs border border-white/20">
          Pilihan Bulanan
        </div>
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase tracking-wider text-primary font-semibold">Bulanan (Kost)</span>
            <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-primary/10 text-primary font-medium">Kamar Pribadi</span>
          </div>
          <div class="mt-5">
            <div class="font-serif text-2xl sm:text-3xl font-normal text-primary">Mulai {monthlyFormatted}</div>
            <span class="text-[11px] text-on-surface-variant font-mono mt-0.5 block">/ kamar / bulan (termasuk pajak daerah)</span>
          </div>
          <p class="text-xs text-on-surface-variant mt-3 leading-relaxed">
            Hunian kost tenang bagi mahasiswa pascasarjana, koas dokter, maupun pekerja di Yogyakarta.
          </p>
          
          <!-- Rincian Transparan: Termasuk vs Bayar Sendiri (Anti-Dispute Billing) -->
          <div class="mt-4 space-y-2 text-xs font-mono">
            <!-- 1. Fasilitas yang SUDAH Termasuk -->
            <div class="p-2.5 rounded-xl bg-emerald-50/90 border border-emerald-200/80">
              <div class="flex items-center gap-1.5 font-semibold text-emerald-900 text-[10px] uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-[14px] text-emerald-600">check_circle</span>
                <span>Sudah Termasuk Sewa:</span>
              </div>
              <ul class="text-[11px] text-emerald-800 space-y-0.5 pl-5 list-disc">
                <li>Gratis WiFi fiber kecepatan tinggi</li>
                <li>Pemakaian unit AC di kamar</li>
                <li>Sudah termasuk pajak daerah</li>
              </ul>
            </div>

            <!-- 2. Fasilitas yang TIDAK Termasuk (Bayar Mandiri) -->
            <div class="p-2.5 rounded-xl bg-amber-50/90 border border-amber-200/80">
              <div class="flex items-center gap-1.5 font-semibold text-amber-900 text-[10px] uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-[14px] text-amber-700">report</span>
                <span>TIDAK Termasuk (Bayar Sendiri):</span>
              </div>
              <ul class="text-[11px] text-amber-900 space-y-0.5 pl-5 list-disc">
                <li><strong>Listrik:</strong> Beli &amp; isi sendiri via token PLN</li>
                <li><strong>Gas water heater:</strong> Mandiri sesuai pemakaian</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-6 pt-5 border-t border-stone-100">
          <a 
            class="group/btn inline-flex items-center justify-between w-full py-2.5 pl-4 pr-1.5 text-xs font-mono font-medium rounded-full bg-primary hover:bg-primary-deep text-white shadow-xs transition-all duration-300 active:scale-[0.98]" 
            href={waMonthlyLink} 
            rel="noopener noreferrer" 
            target="_blank"
          >
            <span>Tanya Sewa Bulanan</span>
            <div class="w-7 h-7 rounded-full bg-white/20 group-hover/btn:bg-white text-white group-hover/btn:text-primary flex items-center justify-center transition-all duration-300">
              <span class="material-symbols-outlined text-[15px] group-hover/btn:translate-x-0.5 transition-transform">arrow_forward</span>
            </div>
          </a>
        </div>
      </div>

    </div>

    <!-- ==================== FOUNDER'S VALUE & TRUST CARD (PESAN IBU AGNESIA) ==================== -->
    <div class="mt-10 sm:mt-12 rounded-3xl p-1 bg-stone-100/90 border border-stone-200/80 shadow-[0_12px_35px_-10px_rgba(40,54,43,0.06)]">
      <div class="rounded-[calc(1.5rem-0.25rem)] bg-gradient-to-br from-white via-stone-50/50 to-amber-50/20 p-6 sm:p-8 lg:p-10 border border-stone-100 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 lg:gap-10">
        
        <!-- Quote Core Narrative -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-8 h-8 rounded-xl bg-syariah-gold/15 text-syariah-gold border border-syariah-gold/25 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[18px]">format_quote</span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-syariah-gold font-semibold">
              Komitmen Ketulusan Layanan
            </span>
          </div>

          <!-- The Authentic Words from Ibu Agnesia -->
          <blockquote class="space-y-2.5 text-on-surface">
            <p class="font-serif text-sm sm:text-base lg:text-lg font-normal italic leading-relaxed text-stone-800">
              &ldquo;Kami tidak mengatakan kami paling murah. Namun jika dibandingkan dengan kualitas yang sama, tidak ada yang memberikan lebih baik dari kami.&rdquo;
            </p>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
              Harga baik mahal atau murah tidak sepenting itu, tetapi <strong>apakah tempat ini benar-benar memenuhi kebutuhan dan ketenangan istirahat Anda</strong>. Mahal belum tentu selalu baik, dan murah belum tentu buruk. Ratusan pelanggan tetap memilih kami karena mereka percaya pada kebersihan, fasilitas nyata, dan ketulusan pelayanan kami.
            </p>
          </blockquote>

          <!-- Founder Attribution Badge -->
          <div class="mt-4 pt-3.5 border-t border-stone-200/60 flex flex-wrap items-center gap-2 text-[11px] font-mono">
            <strong class="text-primary font-semibold">Ibu Agnesia Hari Kardyantini</strong>
            <span class="text-stone-400">•</span>
            <span class="text-stone-500">Pemilik &amp; Pengelola Grha Vege Jawi Syariah</span>
          </div>
        </div>

        <!-- Direct WhatsApp Consultation CTA -->
        <div class="shrink-0 w-full lg:w-auto">
          <a 
            href="https://wa.me/628122729637?text=Halo%20Ibu%20Agnesia,%20saya%20ingin%20konsultasi%20kebutuhan%20kamar%20menginap%20di%20Grha%20Vege%20Jawi"
            target="_blank"
            rel="noopener noreferrer"
            class="group w-full lg:w-auto inline-flex items-center justify-between gap-3 bg-syariah-gold hover:bg-yellow-500 text-on-surface font-semibold pl-4 pr-1.5 py-1.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 text-xs active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-syariah-gold"
          >
            <span class="font-mono text-primary-deep font-semibold">Konsultasi Kamar Langsung ke Bu Agnes</span>
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center transition-transform duration-300 group-hover:scale-105 shadow-xs shrink-0">
              <span class="material-symbols-outlined text-[17px]">chat</span>
            </div>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
