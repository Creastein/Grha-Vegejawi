---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Grha Vege Jawi Syariah - Hunian yang Nyaman dan Tenang di Yogyakarta",
  description = "Grha Vegejawi Syariah, hunian yang nyaman dan tenang di Banguntapan, Bantul, Yogyakarta. Total 6 kamar (2 di lantai bawah, 4 di lantai atas) bisa untuk keluarga. Dilengkapi kamar mandi dalam, AC, TV, WiFi, dapur mini, dental kit, dan parkir mobil."
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://grhavegejawi.com').href;
const gmapsUrl = "https://www.google.com/maps/place/Grha+Vege+Jawi+Syariah/@-7.7919649,110.4029812,747m/data=!3m2!1e3!4b1!4m9!3m8!1s0x2e7a59f05b3c9853:0xec78eefc19d7a5a8!5m2!4m1!1i2!8m2!3d-7.7919649!4d110.4029812!16s%2Fg%2F11f773xm6s";
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="id">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Meta Sosial -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="id_ID" />
  <meta property="og:site_name" content="Grha Vege Jawi Syariah" />

  <!-- Google Fonts: Editorial Serif + Modern Grotesk + Monospace -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap" rel="stylesheet"/>
  
  <!-- Material Symbols Outlined -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>

  <!-- Schema.org JSON-LD (Hotel / Lodging Syariah dengan Koordinat & Rating Terverifikasi) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LodgingBusiness", "Hotel"],
    "name": "Grha Vege Jawi Syariah",
    "description": description,
    "telephone": "+628122729637",
    "priceRange": "Rp 165.000 - Rp 1.870.000",
    "hasMap": gmapsUrl,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Jl. Turonggo No.125, Jaranan, Banguntapan",
      "addressLocality": "Kec. Banguntapan, Kabupaten Bantul",
      "addressRegion": "Daerah Istimewa Yogyakarta",
      "postalCode": "55189",
      "addressCountry": "ID"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -7.7919649,
      "longitude": 110.4029812
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.6",
      "reviewCount": "308",
      "bestRating": "5",
      "worstRating": "1"
    },
    "amenityFeature": [
      { "@type": "LocationFeatureSpecification", "name": "AC", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Kamar Mandi Dalam Air Panas 24 Jam", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Mushola Representatif Bersih", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Free High-Speed Wi-Fi", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Parkir Mobil Aman di Dalam Pagar", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Dapur Mini & Dispenser Galon", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Dental Kit", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Kopi, Teh, Gula & Air Mineral", "value": true }
    ]
  })} />
</head>

<body class="bg-surface-canvas font-sans text-on-surface antialiased selection:bg-primary/15 selection:text-primary min-h-screen flex flex-col relative tactile-grain">
  <slot />
</body>
</html>
