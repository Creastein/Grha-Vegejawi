---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Grha Vege Jawi Syariah - Penginapan Nyaman Dekat JEC Jogja",
  description = "Guesthouse syariah resmi di Banguntapan, Bantul, Yogyakarta. 6 kamar tidur ber-AC, water heater 24 jam, mushola bersih & parkir mobil aman. 5 menit ke JEC & Gembira Loka."
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://www.grhavegejawi.com').href;
const gmapsUrl = "https://www.google.com/maps/place/Grha+Vege+Jawi+Syariah/@-7.7919649,110.4029812,747m/data=!3m2!1e3!4b1!4m9!3m8!1s0x2e7a59f05b3c9853:0xec78eefc19d7a5a8!5m2!4m1!1i2!8m2!3d-7.7919649!4d110.4029812!16s%2Fg%2F11f773xm6s";
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="id">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  
  <!-- Indexing & Crawlers Rules -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="8kQ1l3oGtY9gzfK29Kjm-_bB9OukkPvPbx6D-gwbuOU" />

  <!-- Google tag (gtag.js) GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4KFSYF5TER"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4KFSYF5TER');

    // WhatsApp Booking Lead Conversion Tracking
    document.addEventListener('DOMContentLoaded', function() {
      document.addEventListener('click', function(e) {
        var target = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
        if (target && typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', {
            event_category: 'booking',
            event_label: target.innerText ? target.innerText.trim() : 'whatsapp_click',
            link_url: target.href
          });
        }
      });
    });
  </script>

  <!-- Geographic & Local SEO Target Tags -->
  <meta name="geo.region" content="ID-YO" />
  <meta name="geo.placename" content="Banguntapan, Bantul, Daerah Istimewa Yogyakarta" />
  <meta name="geo.position" content="-7.7919649;110.4029812" />
  <meta name="ICBM" content="-7.7919649, 110.4029812" />

  <!-- Open Graph / Meta Sosial -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="id_ID" />
  <meta property="og:site_name" content="Grha Vege Jawi Syariah" />
  <meta property="og:image" content="https://www.grhavegejawi.com/image/hero.webp" />
  <meta property="og:image:width" content="1447" />
  <meta property="og:image:height" content="1087" />
  <meta property="og:image:alt" content="Fasad Depan Grha Vege Jawi Syariah Yogyakarta" />

  <!-- Twitter / X Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.grhavegejawi.com/image/hero.webp" />

  <!-- Critical LCP Image Preload -->
  <link rel="preload" as="image" href="/image/hero.webp" fetchpriority="high" type="image/webp" />

  <!-- Google Fonts & Material Symbols: Non-Render-Blocking Asynchronous Loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap" 
    media="print" 
    onload="this.media='all'" 
  />
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" 
    media="print" 
    onload="this.media='all'" 
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
  </noscript>

  <!-- Schema.org JSON-LD (@graph Multi-Entity: LodgingBusiness, Person, WebSite, BreadcrumbList, FAQPage) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LodgingBusiness", "Hotel", "BedAndBreakfast"],
        "@id": "https://www.grhavegejawi.com/#lodging",
        "name": "Grha Vege Jawi Syariah",
        "alternateName": "Grha Vegejawi Syariah",
        "description": description,
        "url": "https://www.grhavegejawi.com",
        "telephone": "+628122729637",
        "priceRange": "Rp 165.000 - Rp 1.650.000",
        "currenciesAccepted": "IDR",
        "paymentAccepted": "Cash, Bank Transfer",
        "image": [
          "https://www.grhavegejawi.com/image/hero.webp",
          "https://www.grhavegejawi.com/image/kamar-lantai-bawah.webp",
          "https://www.grhavegejawi.com/image/kamar-lantai-atas-160.webp",
          "https://www.grhavegejawi.com/image/kamar-lantai-atas-140.webp",
          "https://www.grhavegejawi.com/image/balkon-lantai-atas.webp",
          "https://www.grhavegejawi.com/image/km-lantai-bawah.webp",
          "https://www.grhavegejawi.com/image/mushola.webp",
          "https://www.grhavegejawi.com/image/parkir-pendopo.webp",
          "https://www.grhavegejawi.com/image/gerbang-masuk.webp"
        ],
        "hasMap": gmapsUrl,
        "checkinTime": "14:00",
        "checkoutTime": "12:00",
        "numberOfRooms": 6,
        "petsAllowed": false,
        "smokingAllowed": false,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Jl. Turonggo No.125, Jaranan, Banguntapan",
          "addressLocality": "Banguntapan, Bantul",
          "addressRegion": "Daerah Istimewa Yogyakarta",
          "postalCode": "55189",
          "addressCountry": "ID"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -7.7919649,
          "longitude": 110.4029812
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.6",
          "reviewCount": "308",
          "bestRating": "5",
          "worstRating": "1"
        },
        "founder": {
          "@id": "https://www.grhavegejawi.com/#owner"
        },
        "amenityFeature": [
          { "@type": "LocationFeatureSpecification", "name": "AC", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Kamar Mandi Dalam Air Panas 24 Jam", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Mushola Representatif Bersih", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Free High-Speed Wi-Fi", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Parkir Mobil Aman di Dalam Pagar", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Dapur Mini & Dispenser Galon", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Dental Kit Higienis", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Kopi, Teh, Gula & Air Mineral", "value": true }
        ]
      },
      {
        "@type": "Person",
        "@id": "https://www.grhavegejawi.com/#owner",
        "name": "Ibu Agnesia Hari Kardyantini",
        "jobTitle": "Pengelola & Pemilik Properti",
        "worksFor": {
          "@id": "https://www.grhavegejawi.com/#lodging"
        },
        "telephone": "+628122729637"
      },
      {
        "@type": "WebSite",
        "@id": "https://www.grhavegejawi.com/#website",
        "url": "https://www.grhavegejawi.com",
        "name": "Grha Vege Jawi Syariah",
        "inLanguage": "id-ID",
        "description": "Website Resmi Grha Vege Jawi Syariah - Guesthouse Khusus Pasangan Sah & Keluarga di Banguntapan Bantul Yogyakarta",
        "publisher": {
          "@id": "https://www.grhavegejawi.com/#lodging"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://www.grhavegejawi.com/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Beranda",
            "item": "https://www.grhavegejawi.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Penginapan Syariah Yogyakarta",
            "item": "https://www.grhavegejawi.com/#tentang"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Grha Vege Jawi Syariah",
            "item": "https://www.grhavegejawi.com/"
          }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": "https://www.grhavegejawi.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Bisakah memesan kamar untuk rombongan keluarga besar?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sangat bisa. Kami memiliki total 6 kamar tidur privat (2 unit di lantai bawah bebas tangga yang ramah lansia/anak, dan 4 unit di lantai atas dengan balkon asri semilir). Anda bebas memesan 1 kamar, 2 kamar, 4 kamar, maupun memborong seluruh 6 kamar sekaligus untuk privasi utuh keluarga saat acara wisuda kampus, liburan bersama, atau hajatan di Yogyakarta."
            }
          },
          {
            "@type": "Question",
            "name": "Apa saja fasilitas yang tersedia di dalam kamar dan area bersama?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Satu kamar standar untuk 2 orang dilengkapi 9 fasilitas utama: kamar mandi dalam dengan water heater air panas 24 jam, unit AC dingin, WiFi fiber kencang, TV, dental kit higienis baru, serta fasilitas gula pasir, teh, kopi, dan air mineral. Tamu juga bebas menggunakan fasilitas bersama: parkir mobil aman di dalam pagar, dapur mini bersama (kompor & kulkas), dan dispenser galon higienis gratis."
            }
          },
          {
            "@type": "Question",
            "name": "Berapa tarif menginap per malam (weekday, weekend & long weekend)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tarif sewa kamar harian (isi 2 orang): Weekday mulai dari Rp 165.000/malam (Senin–Kamis), dan Weekend mulai dari Rp 220.000/malam (Jumat–Minggu). Untuk periode Long Weekend dan libur nasional, tarif berlaku dinamis menyesuaikan ketersediaan, silakan langsung konfirmasi ke WhatsApp Ibu Agnesia."
            }
          },
          {
            "@type": "Question",
            "name": "Bagaimana ketentuan dan biaya untuk sewa bulanan (kost)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sewa kamar bulanan mulai dari Rp 1.650.000/bulan (sudah termasuk pajak daerah). Biaya sewa bulanan sudah gratis WiFi fiber kecepatan tinggi dan unit AC. Sementara untuk pengisian listrik (token PLN) dan gas water heater dikelola dan dibayar secara mandiri oleh penyewa sesuai pemakaian pribadi."
            }
          },
          {
            "@type": "Question",
            "name": "Bagaimana akses jalan mobil dan kemudahan pesan antar makanan online?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Akses jalan lingkungan beraspal dan paving halus yang sangat leluasa untuk papasan dua mobil langsung masuk ke halaman parkir aman di dalam pagar. Berada di kawasan kampus, titik lokasi sangat akurat di Google Maps sehingga kurir ojek online (GoFood, GrabFood, ShopeeFood) maupun taksi online dapat mengantar dan menjemput tepat di depan gerbang penginapan."
            }
          },
          {
            "@type": "Question",
            "name": "Dokumen apa saja yang diperlukan saat check-in bagi pasangan suami istri?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Cukup menunjukkan e-KTP dengan alamat domisili yang sama, atau foto/buku fisik Buku Nikah resmi dari KUA / Akta Perkawinan catatan sipil. Kami senantiasa menjaga lingkungan hunian syariah yang santun, amanah, dan nyaman bagi seluruh keluarga."
            }
          }
        ]
      }
    ]
  })} />
</head>

<body class="bg-surface-canvas font-sans text-on-surface antialiased selection:bg-primary/15 selection:text-primary min-h-screen flex flex-col relative tactile-grain">
  <slot />
</body>
</html>
