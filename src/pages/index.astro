---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import Hero from '../components/Hero.astro';
import AboutBrand from '../components/AboutBrand.astro';
import RoomPricing from '../components/RoomPricing.astro';
import Facilities from '../components/Facilities.astro';
import GuestReviews from '../components/GuestReviews.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import LocationTransit from '../components/LocationTransit.astro';
import RulesFaq from '../components/RulesFaq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getPricing } from '../lib/pricing';

// Fetch dynamic pricing data dari Google Sheets (dengan proteksi fallback & SWR cache)
const pricing = await getPricing();

// Edge CDN Caching (Vercel ISR): TTFB < 50ms, refresh background tiap 10 menit
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=600, stale-while-revalidate=86400'
);
---

<Layout>
  <HeaderNav />
  <main class="flex-1 w-full">
    <Hero startingPrice={pricing.weekdayPrice} />
    <Facilities />
    <AboutBrand />
    <RoomPricing pricing={pricing} />
    <GalleryLightbox />
    <GuestReviews />
    <LocationTransit />
    <RulesFaq />
    <CtaBanner />
  </main>
  <Footer />
</Layout>
